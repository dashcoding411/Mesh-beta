rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function incomingData() {
      return request.resource.data;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Unambiguous slurs only (no context available here); see src/lib/moderation.js.
    // Generated by scripts/rules-slur-regex.mjs. Do not edit by hand.
    function hateFree(s) {
      return !s.lower().matches('(?s).*(n+[ ._*-]?[i1!|*]+[ ._*-]?[g9]+[ ._*-]?[g9]+[ ._*-]?[e3*]+[ ._*-]?r+|n+[ ._*-]?[i1!|*]+[ ._*-]?[g9]+[ ._*-]?[g9]+[ ._*-]?[a4@*]+|f+[ ._*-]?[a4@*]+[ ._*-]?[g9]+[ ._*-]?[g9]+[ ._*-]?[o0*]+[ ._*-]?[t7]+|p+[ ._*-]?[a4@*]+[ ._*-]?j+[ ._*-]?[e3*]+[ ._*-]?[e3*]+[ ._*-]?[t7]+|c+u+r+r+y+m+u+n+c+h+[e3*]+r+|c+u+r+r+y+[ ._-]*m+u+n+c+h+[e3*]+r+|[s5$]+[t7]+r+[e3*]+[e3*]+[t7]+[s5$]+h+[i1!|*]+[t7]+[t7]+[e3*]+r+|[s5$]+[t7]+r+[e3*]+[e3*]+[t7]+[ ._-]*[s5$]+h+[i1!|*]+[t7]+[t7]+[e3*]+r+|p+[o0*]+[o0*]+[i1!|*]+n+l+[o0*]+[o0*]+|p+[o0*]+[o0*]+[ ._-]*[i1!|*]+n+[ ._-]*l+[o0*]+[o0*]+|p+[o0*]+[o0*]+[ ._-]*[i1!|*]+n+[ ._-]*[t7]+h+[e3*]+[ ._-]*l+[o0*]+[o0*]+|p+[o0*]+r+c+h+m+[o0*]+n+k+[e3*]+y+|p+[o0*]+r+c+h+[ ._-]*m+[o0*]+n+k+[e3*]+y+|j+u+n+[g9]+l+[e3*]+[b8]+u+n+n+y+|j+u+n+[g9]+l+[e3*]+[ ._-]*[b8]+u+n+n+y+|j+[ ._*-]?[i1!|*]+[ ._*-]?[g9]+[ ._*-]?[a4@*]+[ ._*-]?[b8]+[ ._*-]?[o0*]+[ ._*-]?[o0*]+|z+[i1!|*]+p+p+[e3*]+r+h+[e3*]+[a4@*]+d+|c+h+[i1!|*]+n+[g9]+c+h+[o0*]+n+[g9]+|c+h+[i1!|*]+n+[g9]+[ ._-]*c+h+[o0*]+n+[g9]+|w+[e3*]+[t7]+[b8]+[a4@*]+c+k+|r+[a4@*]+[g9]+h+[e3*]+[a4@*]+d+|[t7]+[o0*]+w+[e3*]+l+h+[e3*]+[a4@*]+d+|m+u+z+r+[a4@*]+[t7]+|d+[i1!|*]+[a4@*]+p+[e3*]+r+h+[e3*]+[a4@*]+d+|[g9]+[o0*]+[a4@*]+[t7]+f+u+c+k+[e3*]+r+|[g9]+[o0*]+[a4@*]+[t7]+[ ._-]*f+u+c+k+[e3*]+r+|[o0*]+v+[e3*]+n+d+[o0*]+d+[g9]+[e3*]+r+|[o0*]+v+[e3*]+n+[ ._-]*d+[o0*]+d+[g9]+[e3*]+r+|[s5$]+h+[e3*]+m+[a4@*]+l+[e3*]+|[b8]+[o0*]+[b8]+[s5$]+[ ._-]*[a4@*]+n+d+[ ._-]*v+[a4@*]+[g9]+[e3*]+n+[e3*]+).*')
        && !s.lower().matches('(?s)(.*[^a-z])?(p+[a4@*]+k+[i1!|*]+|k+[i1!|*]+k+[e3*]+|[g9]+[o0*]+[o0*]+k+|[b8]+[o0*]+[o0*]+n+[g9]+|[g9]+y+p+p+[o0*]+|h+[o0*]+n+k+y+|d+[o0*]+[t7]+h+[e3*]+[a4@*]+d+|[t7]+r+[o0*]+[o0*]+n+|m+u+z+z+[i1!|*]+[e3*]+|[b8]+[e3*]+[a4@*]+n+[e3*]+r+|p+[o0*]+l+[a4@*]+c+k+)(e?s)?([^a-z].*)?');
    }
    // Suspended accounts can read but not create or modify content.
    function notSuspended() {
      return myProfile().get('suspendedUntil', timestamp.date(2000, 1, 1)) < request.time;
    }
    // Counters may move by exactly one per write.
    function onlyKey(field) {
      return incomingData().diff(resource.data).affectedKeys().hasOnly([field]);
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // Denormalised author name/photo must match the author's profile.
    function isMyName(n) {
      return n == myProfile().username;
    }
    function isMyDisplayName(n) {
      return n == myProfile().username || n == myProfile().get('name', '');
    }
    function isMyPhoto(u) {
      return u == myProfile().get('photoURL', '');
    }
    function authorIsMe(d) {
      return d.authorId == request.auth.uid
        && isMyName(d.authorName)
        && isMyDisplayName(d.get('authorDisplayName', myProfile().username))
        && isMyPhoto(d.get('authorPhoto', ''));
    }
    // Our own upload or a Google account photo; never an arbitrary URL (IP leak).
    function photoOk(u) {
      return u is string && u.size() <= 2000
        && (u == ''
            || ownInlineImage(u)
            || u.matches('^https://(firebasestorage[.]googleapis[.]com|lh[0-9][.]googleusercontent[.]com)/.*$'));
    }
    // A counter moves by one in the same write that creates or deletes the
    // record it counts; the post-write value is checked too.
    function tiedCount(self, field, rel) {
      let before = resource.data.get(field, 0);
      let after = incomingData().get(field, 0);
      return after is int
        && getAfter(self).data.get(field, 0) == after
        && ((after == before + 1 && existsAfter(rel) && !exists(rel))
            || (after == before - 1 && !existsAfter(rel) && exists(rel)));
    }
    // Rate limiting: each write kind stamps rateLimits/{uid} with request.time in
    // the same batch and is refused if the previous stamp is too recent.
    function rateOk(kind, seconds) {
      let path = /databases/$(database)/documents/rateLimits/$(request.auth.uid);
      return getAfter(path).data.get(kind, null) == request.time
        && (!exists(path) || get(path).data.get(kind, timestamp.value(0)) < request.time - duration.value(seconds, 's'));
    }
    function validBirthYear(y) {
      return y is int && (y == 0 || (y >= request.time.year() - 120 && y <= request.time.year() - 13));
    }
    // Birth year is private (users/{uid}/private/age). Accounts not yet
    // migrated still carry it on the profile.
    function birthYearOf(uid) {
      let agePath = /databases/$(database)/documents/users/$(uid)/private/age;
      return exists(agePath) ? get(agePath).data.birthYear : profileOf(uid).get('birthYear', 0);
    }
    function myBirthYear() {
      return birthYearOf(request.auth.uid);
    }
    // Public posting requires 16+.
    function isAdult() {
      return myBirthYear() > 0 && request.time.year() - myBirthYear() >= 16;
    }
    // Circle age limit: 0 = none; otherwise requires a qualifying birth year.
    function oldEnoughFor(limitYears) {
      return limitYears == 0 || (myBirthYear() > 0 && request.time.year() - myBirthYear() >= limitYears);
    }
    function guest() {
      return request.auth == null;
    }

    // Shared vocabularies (keep in sync with src/lib/interests.js)
    function interestIds() {
      return ['music', 'sport', 'fitness', 'gaming', 'art', 'film', 'books', 'tech', 'science', 'food', 'travel', 'fashion', 'wellbeing', 'nature', 'animals', 'photography', 'comedy', 'learning', 'business', 'cars', 'podcasts', 'gardening', 'local'];
    }
    function newsTopicIds() {
      return ['world', 'local', 'politics', 'business', 'tech', 'science', 'health', 'environment', 'sport', 'culture'];
    }
    // Sources must be http(s) URLs.
    function keyPointOk(k, i) {
      return k.size() <= i || (k[i] is string && k[i].size() <= 200);
    }
    function sourceOk(s, i) {
      return s.size() <= i || (s[i] is string && s[i].size() <= 1000 && s[i].matches('^https?://[^ ]+$'));
    }
    function newsSourcesOk(s) {
      return sourceOk(s, 0) && sourceOk(s, 1) && sourceOk(s, 2) && sourceOk(s, 3) && sourceOk(s, 4)
        && sourceOk(s, 5) && sourceOk(s, 6) && sourceOk(s, 7) && sourceOk(s, 8) && sourceOk(s, 9);
    }
    function validTopics(list) {
      return list is list && list.size() <= 3 && list.hasOnly(interestIds());
    }
    function gifOk(g) {
      return g is map && g.url is string && g.url.matches('^https://media[0-9]*[.]giphy[.]com/.*$');
    }
    // Inline photos: mesh-media:<id>, owned by the caller.
    function ownInlineImage(url) {
      return url.matches('^mesh-media:[A-Za-z0-9]{20}$')
        && get(/databases/$(database)/documents/media/$(url.split(':')[1])).data.ownerId == request.auth.uid;
    }

    // Privacy and blocking
    function profileOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    // Has `uid` blocked the caller?
    function blockedBy(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)/blocked/$(request.auth.uid));
    }
    function follows(uid, target) {
      return exists(/databases/$(database)/documents/users/$(uid)/following/$(target));
    }
    // Can the caller start or add `uid` to a chat: not blocked, and `uid`
    // accepts messages from the caller.
    function reachable(uid) {
      return !blockedBy(uid)
        && (profileOf(uid).get('messagePolicy', 'everyone') == 'everyone'
            || follows(uid, request.auth.uid));
    }

    // Notifications are written by the actor. The id is deterministic per
    // action, the underlying action must exist, and quoted text must be a
    // prefix of the original.
    function noticeHappened(uid, id, n) {
      let actor = request.auth.uid;
      let postPath = /databases/$(database)/documents/posts/$(n.postId);
      return (n.type == 'like' && id == 'like_' + n.postId + '_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/posts/$(n.postId)/likes/$(actor))
            && get(postPath).data.authorId == uid)
        || (n.type == 'repost' && id == 'repost_' + n.postId + '_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/reposts/$(n.postId + '_' + actor))
            && get(postPath).data.authorId == uid)
        || (n.type == 'comment' && id == 'comment_' + n.commentId
            && get(/databases/$(database)/documents/posts/$(n.postId)/comments/$(n.commentId)).data.authorId == actor
            && get(/databases/$(database)/documents/posts/$(n.postId)/comments/$(n.commentId)).data.text[0:n.text.size()] == n.text
            && get(postPath).data.authorId == uid)
        || (n.type == 'mention' && id == 'mention_' + n.postId
            && get(postPath).data.authorId == actor
            && get(postPath).data.visibility == 'public'
            && get(postPath).data.createdAt > request.time - duration.value(10, 'm')
            && get(postPath).data.text[0:n.text.size()] == n.text
            && get(postPath).data.text.lower().matches('(?s)(.*[^a-z0-9_.])?@' + profileOf(uid).username + '([^a-z0-9_].*)?'))
        || (n.type == 'follow' && id == 'follow_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/users/$(uid)/followers/$(actor)))
        || (n.type == 'request' && id == 'request_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/users/$(uid)/followRequests/$(actor)))
        || (n.type == 'accept' && id == 'accept_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/users/$(actor)/followers/$(uid)))
        || familyNotice(uid, id, n, actor)
        || inviteNotice(uid, id, n, actor)
        || storyNotice(uid, id, n, actor);
    }
    // Story likes and echoes (`ref` is the story id).
    function storyNotice(uid, id, n, actor) {
      let storyPath = /databases/$(database)/documents/stories/$(n.ref);
      return (n.type == 'storylike' && id == 'storylike_' + n.ref + '_' + actor && n.text == ''
            && exists(/databases/$(database)/documents/stories/$(n.ref)/likes/$(actor))
            && get(storyPath).data.authorId == uid)
        || (n.type == 'echo' && id == 'echo_' + n.commentId
            && get(/databases/$(database)/documents/stories/$(n.ref)/echoes/$(n.commentId)).data.authorId == actor
            && get(/databases/$(database)/documents/stories/$(n.ref)/echoes/$(n.commentId)).data.text[0:n.text.size()] == n.text
            && get(storyPath).data.authorId == uid);
    }
    // Gathering invites (by the host) and circle admissions (by a moderator).
    function inviteNotice(uid, id, n, actor) {
      let eventPath = /databases/$(database)/documents/events/$(n.ref);
      return (n.type == 'invite' && id == 'invite_' + n.ref && n.text == ''
            && get(eventPath).data.hostId == actor
            && uid in get(eventPath).data.get('invitees', []))
        || (n.type == 'joined' && id == 'joined_' + n.ref && n.text == ''
            && isModOf(n.ref)
            && exists(/databases/$(database)/documents/groups/$(n.ref)/members/$(uid)));
    }

    // Carousel slide: an inline or Storage URL, never external. Only slide 0's
    // ownership is checked; checking all ten would exceed the lookup budget.
    function slideOk(m) {
      return m is map
        && m.keys().hasOnly(['url', 'alt', 'w', 'h'])
        && m.url is string
        && (m.url.matches('^mesh-media:[A-Za-z0-9]{20}$') || m.url.matches('^https://firebasestorage[.]googleapis[.]com/.*'))
        && m.get('alt', '') is string && m.get('alt', '').size() <= 500
        && m.get('w', 0) is int && m.get('h', 0) is int;
    }
    function slidesOk(list) {
      return list is list && list.size() >= 2 && list.size() <= 10
        && slideOk(list[0]) && slideOk(list[1])
        && (list.size() < 3 || slideOk(list[2])) && (list.size() < 4 || slideOk(list[3]))
        && (list.size() < 5 || slideOk(list[4])) && (list.size() < 6 || slideOk(list[5]))
        && (list.size() < 7 || slideOk(list[6])) && (list.size() < 8 || slideOk(list[7]))
        && (list.size() < 9 || slideOk(list[8])) && (list.size() < 10 || slideOk(list[9]));
    }

    function postCreateOk(d, circleMod) {
      return d.keys().hasOnly([
            'kind', 'authorId', 'authorName', 'authorDisplayName', 'authorPhoto', 'text', 'title',
            'alt', 'mediaUrl', 'mediaPath', 'mediaType', 'groupId', 'visibility',
            'duration', 'trailerStart', 'aiGenerated', 'topics', 'poll', 'gif', 'sensitive', 'circleTopic',
            'pollVotes0', 'pollVotes1', 'pollVotes2', 'pollVotes3',
            'likeCount', 'commentCount', 'saveCount', 'sendCount', 'repostCount',
            'viewCount', 'completeCount', 'createdAt', 'media', 'location'
          ])
          && validTopics(d.get('topics', []))
          && d.get('location', '') is string && d.get('location', '').size() <= 60
          && (!('media' in d) || (d.kind == 'post' && slidesOk(d.media) && d.media[0].url == d.mediaUrl))
          && d.get('circleTopic', '') is string && d.get('circleTopic', '').size() <= 40
          && notSuspended()
          && authorIsMe(d)
          && d.createdAt == request.time
          && rateOk('post', 10)
          && d.get('viewCount', 0) == 0
          && d.get('completeCount', 0) == 0
          && d.get('mediaType', '') is string && d.get('mediaType', '').size() <= 100
          && d.get('mediaPath', '') is string && d.get('mediaPath', '').size() <= 500
          // Blocklisted terms are only allowed when flagged `sensitive` (rendered collapsed).
          && d.get('sensitive', false) is bool
          && (d.get('sensitive', false) == true
              || (hateFree(d.text + ' ' + d.title + ' ' + d.alt + ' ' + d.get('location', ''))
                  && (!('poll' in d) || hateFree(d.poll.options.join(' ')))))
          // Polls: 2-4 short options, open at most a week, zero votes.
          && (!('poll' in d)
              || (d.kind == 'text'
                  && d.poll.keys().hasOnly(['options', 'endsAt'])
                  && d.poll.options is list
                  && d.poll.options.size() >= 2
                  && d.poll.options.size() <= 4
                  && d.poll.options[0] is string && d.poll.options[0].size() <= 50
                  && d.poll.options[1] is string && d.poll.options[1].size() <= 50
                  && (d.poll.options.size() < 3 || (d.poll.options[2] is string && d.poll.options[2].size() <= 50))
                  && (d.poll.options.size() < 4 || (d.poll.options[3] is string && d.poll.options[3].size() <= 50))
                  && d.poll.endsAt is timestamp
                  && d.poll.endsAt > request.time
                  && d.poll.endsAt < request.time + duration.value(169, 'h')
                  && d.pollVotes0 == 0 && d.pollVotes1 == 0
                  && d.pollVotes2 == 0 && d.pollVotes3 == 0))
          && (!('gif' in d) || (d.kind == 'text' && gifOk(d.gif)))
          && d.authorId == request.auth.uid
          && d.kind in ['post', 'text', 'short', 'video']
          // Outside circles: public (adults with public accounts) or followers.
          // Inside circles: decided by circlePostOkAs.
          && ((d.groupId == ''
                && (d.visibility == 'followers'
                    || (d.visibility == 'public' && isAdult()
                        && myProfile().get('isPrivate', false) != true)))
              || (d.groupId != '' && circlePostOkAs(d, circleMod)))
          && d.text is string
          && d.text.size() <= 5000
          && d.title is string
          && d.title.size() <= 150
          && d.alt is string
          && d.alt.size() <= 500
          && d.likeCount == 0
          && d.commentCount == 0
          && d.saveCount == 0
          && d.sendCount == 0
          && d.get('repostCount', 0) == 0
          && d.get('duration', 0) is number
          && d.get('duration', 0) >= 0
          && d.get('duration', 0) <= 43200
          && d.get('trailerStart', 0) is number
          && d.get('trailerStart', 0) >= 0
          && d.get('aiGenerated', false) is bool
          // Strands: up to 500 chars, no uploaded media. Other kinds need a Storage
          // URL, or an owned inline photo for Stills.
          && ((d.kind == 'text'
                && d.mediaUrl == ''
                && d.mediaPath == ''
                && d.text.size() <= 500
                && (d.text.size() >= 1 || 'gif' in d))
              || (d.kind != 'text'
                && d.mediaUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*'))
              || (d.kind == 'post' && ownInlineImage(d.mediaUrl)));
    }

    // Brick mode. locks/{uid} holds the user's own layer and, for linked
    // under-18s, a parent layer. Browsing reads check lockedFor(); messaging
    // never does. Windows are half-hour slots per local day (d1 = Monday).
    function localTime(l) {
      return request.time + duration.value(l.get('tzOffset', 0), 'm');
    }
    function dayKeyOf(l) {
      let t = localTime(l);
      return string(t.year()) + '-' + string(t.dayOfYear());
    }
    function slotOf(t) {
      return t.hours() * 2 + (t.minutes() >= 30 ? 1 : 0);
    }
    function layerBricked(x, t) {
      return x.get('until', timestamp.value(0)) > request.time
        || x.get('slots', {}).get('d' + string(t.dayOfWeek()), []).hasAny([slotOf(t)]);
    }
    function capOf(x, section) {
      return x.get('caps', {}).get(section, 0);
    }
    // Parent layers lapse on 1 January of the year the account holder turns 18.
    function parentOn(l) {
      return l.get('parent', null) != null && request.time < timestamp.date(l.parent.untilYear, 1, 1);
    }
    function usedToday(l, section) {
      let path = /databases/$(database)/documents/usage/$(request.auth.uid + '_' + dayKeyOf(l));
      return exists(path) ? get(path).data.get(section, 0) : 0;
    }
    function capHit(l, section) {
      let own = capOf(l.self, section);
      let par = parentOn(l) ? capOf(l.parent, section) : 0;
      return (own > 0 || par > 0)
        && ((own > 0 && usedToday(l, section) >= own * 60) || (par > 0 && usedToday(l, section) >= par * 60));
    }
    function lockedBy(l, section) {
      let t = localTime(l);
      return layerBricked(l.self, t)
        || (parentOn(l) && layerBricked(l.parent, t))
        || (section != '' && capHit(l, section));
    }
    // section: 'feed' | 'flicks' | 'news', or '' for locks covering everything.
    function lockedFor(section) {
      let path = /databases/$(database)/documents/locks/$(request.auth.uid);
      return exists(path) && lockedBy(get(path).data, section);
    }
    function sectionOfKind(kind) {
      return kind in ['short', 'video'] ? 'flicks' : 'feed';
    }

    // Shape checks are deliberately light (evaluation budget); malformed
    // values fail closed, which can only lock more.
    function validLayerBody(x) {
      return x is map
        && x.slots is map && x.slots.keys().hasOnly(['d1', 'd2', 'd3', 'd4', 'd5', 'd6', 'd7'])
        && x.caps is map && x.caps.keys().hasOnly(['feed', 'flicks', 'news'])
        && x.until is timestamp && x.until <= request.time + duration.value(8, 'd')
        && x.get('since', timestamp.value(0)) is timestamp
        && x.get('windows', []).size() <= 21;
    }
    function validLayer(x) {
      return validLayerBody(x) && x.keys().hasOnly(['slots', 'caps', 'until', 'since', 'windows']);
    }
    function capNoLooser(a, b) {
      return a == b || (a > 0 && (b == 0 || a < b));
    }
    // `a` is at least as strict as `b`: no slot unlocked, no cap raised or
    // removed, no instant brick shortened.
    function tighterOrSame(a, b) {
      return a.slots.get('d1', []).hasAll(b.slots.get('d1', []))
        && a.slots.get('d2', []).hasAll(b.slots.get('d2', []))
        && a.slots.get('d3', []).hasAll(b.slots.get('d3', []))
        && a.slots.get('d4', []).hasAll(b.slots.get('d4', []))
        && a.slots.get('d5', []).hasAll(b.slots.get('d5', []))
        && a.slots.get('d6', []).hasAll(b.slots.get('d6', []))
        && a.slots.get('d7', []).hasAll(b.slots.get('d7', []))
        && capNoLooser(a.caps.get('feed', 0), b.caps.get('feed', 0))
        && capNoLooser(a.caps.get('flicks', 0), b.caps.get('flicks', 0))
        && capNoLooser(a.caps.get('news', 0), b.caps.get('news', 0))
        && (a.until >= b.until || b.until <= request.time);
    }
    function validLock(d) {
      return d.keys().hasOnly(['tzOffset', 'tzName', 'tzChangedAt', 'slotsChangedAt', 'self', 'pending', 'parent', 'parentRequest', 'updatedAt'])
        && d.tzOffset is int && d.tzOffset >= -720 && d.tzOffset <= 840
        && d.tzName is string && d.tzName.size() <= 64
        && d.tzChangedAt is timestamp
        && validLayer(d.self)
        && (d.get('pending', null) == null
            || (d.pending.keys().hasOnly(['self', 'requestedAt', 'tzOffset', 'tzName'])
                && validLayer(d.pending.self)
                && d.pending.requestedAt is timestamp
                && d.pending.get('tzOffset', 0) is int && d.pending.get('tzOffset', 0) >= -720 && d.pending.get('tzOffset', 0) <= 840))
        && (d.get('parentRequest', null) == null
            || (d.parentRequest.keys().hasOnly(['self', 'note', 'unlink', 'at'])
                && validLayer(d.parentRequest.self)
                && d.parentRequest.note is string && d.parentRequest.note.size() <= 280
                && d.parentRequest.unlink is bool
                && d.parentRequest.at is timestamp));
    }
    function isParentOf(uid) {
      let link = /databases/$(database)/documents/familyLinks/$(uid);
      return signedIn() && exists(link)
        && get(link).data.parentId == request.auth.uid
        && get(link).data.status == 'active';
    }
    function parentLayerOk(uid, p) {
      return p.keys().hasOnly(['slots', 'caps', 'until', 'windows', 'parentId', 'parentName', 'untilYear'])
        && validLayerBody(p)
        && p.parentId == request.auth.uid
        && isMyName(p.parentName)
        && p.untilYear == birthYearOf(uid) + 18;
    }
    // Owner changes: tightening applies immediately; loosening only via
    // `pending`, applicable after 24h.
    function pendingOk(n, o) {
      let np = n.get('pending', null);
      let op = o.get('pending', null);
      return np == op
        || np == null
        || np.requestedAt == request.time
        || (op != null && np.requestedAt == op.requestedAt
            && np.get('tzOffset', null) == op.get('tzOffset', null)
            && tighterOrSame(np.self, op.self));
    }
    // ±1h offset change (DST) at most every 20 days; larger changes go through `pending`.
    function tzOk(n, o) {
      return (n.tzOffset == o.tzOffset && n.tzChangedAt == o.tzChangedAt)
        || (math.abs(n.tzOffset - o.tzOffset) <= 60
            && o.tzChangedAt < request.time - duration.value(20, 'd')
            && n.tzChangedAt == request.time);
    }
    // `since` marks an instant brick's start (for stats); extending keeps it.
    function sinceOk(n, o) {
      let ns = n.self.get('since', timestamp.value(0));
      let os = o.self.get('since', timestamp.value(0));
      return (n.self.until <= o.self.until && ns == os)
        || (n.self.until > o.self.until && o.self.until > request.time && ns == os)
        || (n.self.until > o.self.until && o.self.until <= request.time && ns == request.time);
    }
    // slotsChangedAt lets stats count a day only against the schedule it had.
    function slotsStampOk(n, o) {
      return n.self.slots == o.self.slots
        ? n.get('slotsChangedAt', null) == o.get('slotsChangedAt', null)
        : n.get('slotsChangedAt', null) == request.time;
    }
    function applyingPending(n, o) {
      let op = o.get('pending', null);
      return op != null
        && request.time >= op.requestedAt + duration.value(24, 'h')
        && n.self == op.self
        && n.get('pending', null) == null
        && slotsStampOk(n, o)
        && n.tzOffset == op.get('tzOffset', o.tzOffset)
        && (n.tzChangedAt == o.tzChangedAt || n.tzChangedAt == request.time);
    }
    function parentRequestOk(n, o) {
      let nr = n.get('parentRequest', null);
      return nr == o.get('parentRequest', null)
        || nr == null
        || (o.get('parent', null) != null && nr.at == request.time);
    }
    // Family-link notices: invite, acceptance, change request.
    function familyNotice(uid, id, n, actor) {
      let linkToMe = /databases/$(database)/documents/familyLinks/$(uid);
      let linkFromActor = /databases/$(database)/documents/familyLinks/$(actor);
      return (n.type == 'family' && id == 'family_' + actor && n.text == ''
            && get(linkToMe).data.parentId == actor)
        || (n.type == 'familyok' && id == 'familyok_' + actor && n.text == ''
            && get(linkFromActor).data.parentId == uid
            && get(linkFromActor).data.status == 'active')
        || (n.type == 'familyask' && id == 'familyask_' + actor
            && get(linkFromActor).data.parentId == uid
            && get(/databases/$(database)/documents/locks/$(actor)).data.get('parentRequest', null) != null
            && get(/databases/$(database)/documents/locks/$(actor)).data.parentRequest.note[0:n.text.size()] == n.text);
    }

    // Circle membership helpers
    function circleOf(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function isMemberOf(groupId) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }
    function membershipIn(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data;
    }
    function isModOf(groupId) {
      return isMemberOf(groupId) && membershipIn(groupId).role in ['owner', 'moderator'];
    }

    // Read access by visibility: public (signed in), followers, circle
    // (members), pending (circle mods until approved); always the author.
    function canReadPost(p) {
      return p.authorId == request.auth.uid
        || p.visibility == 'public'
        || (p.visibility == 'followers'
            && exists(/databases/$(database)/documents/users/$(p.authorId)/followers/$(request.auth.uid)))
        || (p.visibility == 'circle' && isMemberOf(p.groupId))
        || (p.visibility == 'pending' && isModOf(p.groupId));
    }

    // Circle limits, mirrored client-side. Mods are exempt from posting limits
    // but not banned words. Kept lean for the evaluation budget.
    function circlePostOkAs(p, mod) {
      let g = circleOf(p.groupId);
      let am = g.get('automod', {});
      let m = membershipIn(p.groupId);
      return (m.get('mutedUntil', null) == null || m.mutedUntil < request.time)
        && (mod || am.get('postingPermission', 'members') != 'admins')
        && (mod || am.size() == 0 || memberPostOk(p, am, m))
        && !(p.text + ' ' + p.title).lower().split('[^a-z0-9]+').hasAny(am.get('bannedWords', []))
        && (p.get('circleTopic', '') == '' || p.circleTopic in g.get('topics', []))
        && p.visibility == (!mod && am.size() > 0 && needsReview(p, am) ? 'pending' : (g.privacy == 'public' ? 'public' : 'circle'));
    }
    function linkActionOf(am) {
      return am.get('linkAction', am.get('blockLinks', false) == true ? 'block' : 'allow');
    }
    function youngFor(am) {
      let days = am.get('newAccountDays', am.get('blockNewAccounts', false) == true ? 7 : 0);
      return days > 0 && request.time < myProfile().createdAt + duration.value(days, 'd');
    }
    // Admin Assist: conditions that decline a post.
    function memberPostOk(p, am, m) {
      let words = (p.text + ' ' + p.title).lower();
      return (linkActionOf(am) != 'block' || !words.matches('(?s).*(https?://|www[.]).*'))
        && (am.get('newAccountAction', 'decline') != 'decline' || !youngFor(am))
        // Contact details (phone, email, card numbers) when the circle blocks them.
        && (am.get('blockContactInfo', false) != true
            || !words.matches('(?s).*([a-z0-9._%+-]+@[a-z0-9-]+[.][a-z0-9.-]*[a-z]{2,}|[+]?([0-9][ ().-]{0,2}){9,}[0-9]).*'))
        && (p.kind != 'text' || p.text.size() >= am.get('minLength', 0))
        && (am.get('mediaAllowed', true) == true || p.kind == 'text')
        && (am.get('declineRecentStrikes', false) != true
            || m.get('lastStrikeAt', timestamp.value(0)) < request.time - duration.value(28, 'd'))
        && (am.get('slowModeMinutes', 0) == 0
            || (getAfter(/databases/$(database)/documents/groups/$(p.groupId)/members/$(request.auth.uid)).data.get('lastPostAt', null) == request.time
                && m.get('lastPostAt', timestamp.value(0)) < request.time - duration.value(am.slowModeMinutes, 'm')));
    }
    // Admin Assist: conditions that hold a post for review.
    function needsReview(p, am) {
      return am.get('requirePostApproval', false) == true
        || (linkActionOf(am) == 'hold' && (p.text + ' ' + p.title).lower().matches('(?s).*(https?://|www[.]).*'))
        || (am.get('newAccountAction', 'decline') == 'hold' && youngFor(am))
        || (am.get('holdNoPhoto', false) == true && myProfile().get('photoURL', '') == '');
    }

    // Reports: one per (reporter, target); readable only by admins. Message and
    // comment reports carry the exact text, verified against the original.
    match /reports/{reportId} {
      allow get, list: if isAdmin();
      allow create: if signedIn()
        && reportId == incomingData().targetType + '_' + incomingData().targetId + '_' + request.auth.uid
        && incomingData().keys().hasOnly(['reporterId', 'targetType', 'targetId', 'postId', 'chatId',
                                          'authorId', 'reason', 'details', 'excerpt', 'status', 'createdAt'])
        && incomingData().reporterId == request.auth.uid
        && incomingData().authorId != request.auth.uid
        && incomingData().status == 'open'
        && incomingData().createdAt == request.time
        && incomingData().reason in ['hate', 'harassment', 'spam', 'violence', 'sexual', 'self_harm', 'misinfo', 'impersonation', 'other']
        && incomingData().get('details', '') is string
        && incomingData().get('details', '').size() <= 500
        && ((incomingData().targetType == 'post'
              && get(/databases/$(database)/documents/posts/$(incomingData().targetId)).data.authorId == incomingData().authorId)
            || (incomingData().targetType == 'comment'
              && get(/databases/$(database)/documents/posts/$(incomingData().postId)/comments/$(incomingData().targetId)).data.authorId == incomingData().authorId
              && get(/databases/$(database)/documents/posts/$(incomingData().postId)/comments/$(incomingData().targetId)).data.text == incomingData().excerpt)
            || (incomingData().targetType == 'message'
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(incomingData().chatId)).data.members
              && get(/databases/$(database)/documents/chats/$(incomingData().chatId)/messages/$(incomingData().targetId)).data.senderId == incomingData().authorId
              && get(/databases/$(database)/documents/chats/$(incomingData().chatId)/messages/$(incomingData().targetId)).data.text == incomingData().excerpt)
            || (incomingData().targetType == 'user'
              && incomingData().targetId == incomingData().authorId
              && exists(/databases/$(database)/documents/users/$(incomingData().targetId))));
      allow update: if isAdmin()
        && incomingData().diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt', 'action'])
        && incomingData().status in ['open', 'actioned', 'dismissed'];
      allow delete: if isAdmin();
    }

    // Suspension reasons: owner and moderators only (suspendedUntil is on the profile).
    match /suspensions/{uid} {
      allow get: if isUser(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && incomingData().keys().hasOnly(['until', 'reason', 'by', 'createdAt'])
        && incomingData().until is timestamp
        && incomingData().reason is string
        && incomingData().reason.size() <= 500;
      allow delete: if isAdmin();
    }

    match /rateLimits/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && incomingData().keys().hasOnly(['post', 'comment', 'media', 'edit'])
        && incomingData().get('post', request.time) == request.time
        && incomingData().get('comment', request.time) == request.time
        && incomingData().get('media', request.time) == request.time
        && incomingData().get('edit', request.time) == request.time;
      allow update: if isUser(uid)
        && incomingData().keys().hasOnly(['post', 'comment', 'media', 'edit'])
        && (incomingData().get('post', null) == resource.data.get('post', null) || incomingData().post == request.time)
        && (incomingData().get('comment', null) == resource.data.get('comment', null) || incomingData().comment == request.time)
        && (incomingData().get('media', null) == resource.data.get('media', null) || incomingData().media == request.time)
        && (incomingData().get('edit', null) == resource.data.get('edit', null) || incomingData().edit == request.time);
      // Deletable only with the account.
      allow delete: if isUser(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Admins (managed in the console)
    match /admins/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Users
    match /users/{uid} {
      // Guests can read profiles once birth year has moved to private/age.
      allow get: if signedIn() || resource.data.get('birthYear', 0) == 0;
      allow list: if signedIn();
      allow create: if isUser(uid)
        && incomingData().keys().hasOnly([
          // No email or phone: user docs are readable by every signed-in user.
          'username', 'name', 'usernameChangedAt', 'bio',
          'pronouns', 'town', 'spouseUsername', 'photoURL',
          'followerCount', 'followingCount', 'createdAt',
          'termsAcceptedAt', 'termsVersion'
        ])
        // Server-set, so account age can't be faked.
        && incomingData().createdAt == request.time
        // The handle must be claimed in the same write.
        && getAfter(/databases/$(database)/documents/usernames/$(incomingData().username)).data.uid == request.auth.uid
        && incomingData().get('usernameChangedAt', null) == null
        && incomingData().get('pronouns', '') is string && incomingData().get('pronouns', '').size() <= 40
        && incomingData().get('town', '') is string && incomingData().get('town', '').size() <= 80
        && incomingData().get('spouseUsername', '') == ''
        && photoOk(incomingData().get('photoURL', ''))
        && incomingData().termsVersion.size() <= 20
        // Consent timestamp is server time.
        && incomingData().termsAcceptedAt == request.time
        && incomingData().termsVersion is string
        && incomingData().termsVersion.size() > 0
        && incomingData().name is string
        && incomingData().name.size() <= 50
        && hateFree(incomingData().name)
        && hateFree(incomingData().bio)
        && hateFree(incomingData().username)
        && incomingData().username is string
        && incomingData().username.size() >= 3
        && incomingData().username.size() <= 30
        && incomingData().username.matches('^[a-z0-9_]+$')
        && incomingData().bio is string
        && incomingData().bio.size() <= 300
        && getAfter(/databases/$(database)/documents/users/$(uid)/private/age).data.birthYear > 0
        && incomingData().followerCount == 0
        && incomingData().followingCount == 0;
      allow update: if signedIn() && (
        (isUser(uid)
          && incomingData().diff(resource.data).affectedKeys().hasOnly([
            'name', 'bio', 'photoURL', 'pronouns', 'town', 'spouseUsername', 'birthYear'
          ])
          // birthYear may only be removed, when it moves to private/age unchanged.
          && (!incomingData().diff(resource.data).affectedKeys().hasAny(['birthYear'])
              || (!('birthYear' in incomingData())
                  && getAfter(/databases/$(database)/documents/users/$(uid)/private/age).data.birthYear == resource.data.birthYear))
          && (!incomingData().diff(resource.data).affectedKeys().hasAny(['photoURL'])
              || photoOk(incomingData().photoURL))
          && incomingData().get('spouseUsername', '') is string
          && incomingData().get('spouseUsername', '').size() <= 50
          && incomingData().name is string
          && incomingData().name.size() >= 1
          && incomingData().name.size() <= 50
          && incomingData().bio is string
          && incomingData().bio.size() <= 300
          && incomingData().pronouns is string
          && incomingData().pronouns.size() <= 40
          && incomingData().town is string
          && incomingData().town.size() <= 80
          && hateFree(incomingData().name + ' ' + incomingData().bio + ' ' + incomingData().pronouns + ' ' + incomingData().town))
        // Moderators may set only suspendedUntil.
        || (isAdmin() && incomingData().diff(resource.data).affectedKeys().hasOnly(['suspendedUntil'])
          && incomingData().suspendedUntil is timestamp)
        // Handle change: unique, once per 30 days.
        || (isUser(uid)
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['username', 'usernameChangedAt'])
          && incomingData().username is string
          && incomingData().username.matches('^[a-z0-9_]{3,30}$')
          && hateFree(incomingData().username)
          && getAfter(/databases/$(database)/documents/usernames/$(incomingData().username)).data.uid == request.auth.uid
          && incomingData().usernameChangedAt == request.time
          // Legacy accounts have no usernameChangedAt.
          && (!('usernameChangedAt' in resource.data)
              || resource.data.usernameChangedAt == null
              || request.time > resource.data.usernameChangedAt + duration.value(30, 'd')))
        || (isUser(uid)
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['isPrivate', 'messagePolicy', 'commentPolicy'])
          && incomingData().get('isPrivate', false) is bool
          && incomingData().get('messagePolicy', 'everyone') in ['everyone', 'following']
          && incomingData().get('commentPolicy', 'everyone') in ['everyone', 'following', 'off'])
        // Follow counts move only with the follow record named by lastFollower/lastFollowing.
        || (incomingData().diff(resource.data).affectedKeys().hasOnly(['followerCount', 'lastFollower'])
          && incomingData().lastFollower is string
          && tiedCount(/databases/$(database)/documents/users/$(uid), 'followerCount',
                       /databases/$(database)/documents/users/$(uid)/followers/$(incomingData().lastFollower)))
        || (incomingData().diff(resource.data).affectedKeys().hasOnly(['followingCount', 'lastFollowing'])
          && incomingData().lastFollowing is string
          && tiedCount(/databases/$(database)/documents/users/$(uid), 'followingCount',
                       /databases/$(database)/documents/users/$(uid)/following/$(incomingData().lastFollowing)))
      );
      allow delete: if isUser(uid);

      // Self-follow for public accounts not blocking the caller; private accounts
      // write the entry on approval. Either side can remove it.
      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if incomingData().keys().hasOnly(['username', 'createdAt'])
          && incomingData().username == profileOf(targetUid).username
          && uid != targetUid
          && ((isUser(uid)
              && !blockedBy(targetUid)
              && profileOf(targetUid).get('isPrivate', false) != true)
            || (isUser(targetUid)
              && exists(/databases/$(database)/documents/users/$(targetUid)/followRequests/$(uid))));
        allow delete: if isUser(uid) || isUser(targetUid);
        allow update: if false;
      }
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if incomingData().keys().hasOnly(['username', 'createdAt'])
          && incomingData().username == profileOf(followerUid).username
          && uid != followerUid
          && ((isUser(followerUid)
              && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(followerUid))
              && profileOf(uid).get('isPrivate', false) != true)
            || (isUser(uid)
              && exists(/databases/$(database)/documents/users/$(uid)/followRequests/$(followerUid))));
        allow delete: if isUser(followerUid) || isUser(uid);
        allow update: if false;
      }
      match /followRequests/{requesterUid} {
        allow read: if isUser(uid) || isUser(requesterUid);
        allow create: if isUser(requesterUid)
          && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(requesterUid))
          && incomingData().keys().hasOnly(['username', 'createdAt'])
          && isMyName(incomingData().username)
          && uid != requesterUid;
        allow delete: if isUser(uid) || isUser(requesterUid);
        allow update: if false;
      }
      // RSVP mirror for upcoming lists.
      match /rsvps/{eventId} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid)
          && incomingData().keys().hasOnly(['status', 'title', 'startsAt', 'location', 'updatedAt'])
          && incomingData().status in ['going', 'interested', 'maybe', 'cant']
          && incomingData().title is string && incomingData().title.size() <= 150
          && incomingData().location is string && incomingData().location.size() <= 300
          && incomingData().startsAt is timestamp
          && incomingData().updatedAt == request.time;
      }
      // Owner reads/updates/deletes; the actor may retract (unlike, unfollow).
      match /notifications/{noticeId} {
        allow read: if isUser(uid);
        allow update: if isUser(uid) && onlyKey('read') && incomingData().read == true;
        allow delete: if isUser(uid) || (signedIn() && resource.data.actorId == request.auth.uid);
        allow create: if signedIn() && uid != request.auth.uid
          && incomingData().keys().hasOnly(['type', 'actorId', 'actorName', 'actorPhoto', 'postId', 'commentId', 'ref', 'text', 'read', 'createdAt'])
          && incomingData().actorId == request.auth.uid
          && isMyName(incomingData().actorName)
          && isMyPhoto(incomingData().actorPhoto)
          && incomingData().read == false
          && incomingData().createdAt == request.time
          && incomingData().postId is string && incomingData().postId.size() <= 128
          && incomingData().commentId is string && incomingData().commentId.size() <= 64
          && incomingData().ref is string && incomingData().ref.size() <= 128
          && incomingData().text is string && incomingData().text.size() <= 140
          && !blockedBy(uid)
          && noticeHappened(uid, noticeId, incomingData());
      }
      match /blocked/{otherUid} {
        allow read, write: if isUser(uid);
      }
      // Private preferences: interests, hidden words, mutes.
      match /private/{docId} {
        allow read: if isUser(uid);
        allow delete: if isUser(uid) && docId != 'age';
        allow create, update: if isUser(uid) && docId == 'prefs'
          && incomingData().get('interests', []) is list
          && incomingData().get('interests', []).size() <= 12
          && incomingData().get('interests', []).hasOnly(interestIds())
          && incomingData().get('hiddenWords', []) is list
          && incomingData().get('hiddenWords', []).size() <= 200
          && incomingData().get('muted', []) is list
          && incomingData().get('muted', []).size() <= 500;
      }
      // Set once: at signup, when migrating off the profile (same value), or
      // for legacy accounts that never set one. Removed only with the profile.
      match /private/age {
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['birthYear'])
          && validBirthYear(incomingData().birthYear) && incomingData().birthYear > 0
          && (!exists(/databases/$(database)/documents/users/$(uid))
              || profileOf(uid).get('birthYear', 0) == 0
              || profileOf(uid).birthYear == incomingData().birthYear);
        allow update: if false;
        allow delete: if isUser(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid));
      }
      match /affinity/{authorId} {
        allow read, write: if isUser(uid);
      }
      match /saved/{postId} {
        allow read, write: if isUser(uid);
      }
      match /hidden/{postId} {
        allow read, write: if isUser(uid);
      }
    }

    // Usernames (uniqueness registry)
    match /usernames/{name} {
      allow read: if true;
      // Claimed only in the same write that sets the profile handle.
      allow create: if signedIn()
        && incomingData().keys().hasOnly(['uid'])
        && incomingData().uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,30}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update: if false;
      // Released only when the profile stops using it.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
            || getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name);
    }

    // Brick mode
    match /locks/{uid} {
      allow read: if isUser(uid) || isParentOf(uid);
      // Initial setup can only add limits.
      allow create: if (isUser(uid)
          && validLock(incomingData())
          && incomingData().get('parent', null) == null
          && incomingData().get('pending', null) == null
          && incomingData().get('parentRequest', null) == null
          && incomingData().tzChangedAt == request.time
          && incomingData().get('slotsChangedAt', null) == request.time
          && (incomingData().self.until <= request.time || incomingData().self.get('since', null) == request.time)
          && incomingData().updatedAt == request.time)
        // Parent layer before the teen has one.
        || (isParentOf(uid)
          && validLock(incomingData())
          && incomingData().self.slots == {} && incomingData().self.caps == {'feed': 0, 'flicks': 0, 'news': 0}
          && incomingData().self.until == timestamp.value(0)
          && incomingData().get('pending', null) == null
          && incomingData().get('parentRequest', null) == null
          && parentLayerOk(uid, incomingData().parent)
          && incomingData().tzChangedAt == request.time
          && incomingData().updatedAt == request.time);
      allow update: if (isUser(uid)
          && validLock(incomingData())
          && incomingData().get('parent', null) == resource.data.get('parent', null)
          && incomingData().updatedAt == request.time
          && parentRequestOk(incomingData(), resource.data)
          && ((tighterOrSame(incomingData().self, resource.data.self)
                && pendingOk(incomingData(), resource.data)
                && tzOk(incomingData(), resource.data)
                && sinceOk(incomingData(), resource.data)
                && slotsStampOk(incomingData(), resource.data))
              || applyingPending(incomingData(), resource.data)))
        // Parent edits only the parent layer and answers requests.
        || (isParentOf(uid)
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['parent', 'parentRequest', 'updatedAt'])
          && incomingData().updatedAt == request.time
          && (incomingData().get('parent', null) == null || parentLayerOk(uid, incomingData().parent))
          && incomingData().get('parentRequest', null) == null);
      // Only with the account; deleting it would lift every limit.
      allow delete: if isUser(uid) && !existsAfter(/databases/$(database)/documents/users/$(uid));
    }

    // Daily minutes per section: owner or linked parent reads; +30s at most
    // every 25s; today's doc can't be deleted.
    match /usage/{docId} {
      function usageOwner() {
        return docId.split('_')[0];
      }
      function todayId() {
        return request.auth.uid + '_' + dayKeyOf(get(/databases/$(database)/documents/locks/$(request.auth.uid)).data);
      }
      function stepOk(k) {
        return incomingData().get(k, 0) is int
          && incomingData().get(k, 0) >= (resource == null ? 0 : resource.data.get(k, 0))
          && incomingData().get(k, 0) <= (resource == null ? 0 : resource.data.get(k, 0)) + 30;
      }
      function totalStepOk() {
        return incomingData().get('feed', 0) + incomingData().get('flicks', 0) + incomingData().get('news', 0)
          <= (resource == null ? 0 : resource.data.get('feed', 0) + resource.data.get('flicks', 0) + resource.data.get('news', 0)) + 30;
      }
      allow get: if signedIn() && (usageOwner() == request.auth.uid || isParentOf(usageOwner()));
      allow list: if signedIn() && (resource.data.uid == request.auth.uid || isParentOf(resource.data.uid));
      allow create: if signedIn() && docId == todayId()
        && incomingData().keys().hasOnly(['uid', 'feed', 'flicks', 'news', 'at'])
        && incomingData().uid == request.auth.uid
        && incomingData().at == request.time
        && stepOk('feed') && stepOk('flicks') && stepOk('news') && totalStepOk();
      allow update: if signedIn() && docId == todayId()
        && incomingData().keys().hasOnly(['uid', 'feed', 'flicks', 'news', 'at'])
        && incomingData().uid == request.auth.uid
        && incomingData().at == request.time
        && resource.data.at < request.time - duration.value(25, 's')
        && stepOk('feed') && stepOk('flicks') && stepOk('news') && totalStepOk();
      allow delete: if signedIn() && usageOwner() == request.auth.uid
        && (!existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) || docId != todayId());
    }

    // Parent/teen link: the parent invites, the teen accepts. Ends when the
    // parent removes it or when the teen turns 18.
    match /familyLinks/{childUid} {
      allow read: if signedIn() && (request.auth.uid == childUid || resource.data.parentId == request.auth.uid);
      allow create: if signedIn()
        && childUid != request.auth.uid
        && incomingData().keys().hasOnly(['parentId', 'parentName', 'childName', 'status', 'createdAt'])
        && incomingData().parentId == request.auth.uid
        && isMyName(incomingData().parentName)
        && incomingData().childName == profileOf(childUid).username
        && incomingData().status == 'invited'
        && incomingData().createdAt == request.time
        && myBirthYear() > 0 && request.time.year() - myBirthYear() >= 19
        && birthYearOf(childUid) > 0 && request.time.year() - birthYearOf(childUid) < 18
        && !blockedBy(childUid)
        && notSuspended();
      // The teen records when the link lapses; the parent can't read their age.
      allow update: if signedIn() && request.auth.uid == childUid
        && (resource.data.status == 'invited' || resource.data.get('untilYear', 0) == 0)
        && incomingData().diff(resource.data).affectedKeys().hasOnly(['status', 'untilYear'])
        && incomingData().status == 'active'
        && incomingData().untilYear == myBirthYear() + 18;
      allow delete: if signedIn()
        && (resource.data.parentId == request.auth.uid
            || (request.auth.uid == childUid
                && (resource.data.status == 'invited'
                    || !existsAfter(/databases/$(database)/documents/users/$(childUid))
                    || request.time >= timestamp.date(myBirthYear() + 18, 1, 1))));
    }

    // Brick stats count only server-enforced time: finished instant bricks and
    // whole past days against the schedule in force. Monotonic; private unless public.
    function statsLock() {
      return get(/databases/$(database)/documents/locks/$(request.auth.uid)).data;
    }
    function weekKeyOf(l) {
      let t = localTime(l);
      let monday = t - duration.value(t.dayOfWeek() - 1, 'd');
      return string(monday.year()) + '-' + string(monday.dayOfYear());
    }
    function statsShapeOk(d) {
      return d.keys().hasOnly(['username', 'name', 'photoURL', 'public', 'totalSeconds', 'weekSeconds', 'weekKey',
                               'streakDays', 'instantUntil', 'scheduleDay', 'updatedAt'])
        && isMyName(d.username)
        && d.name == myProfile().get('name', '')
        && d.photoURL == myProfile().get('photoURL', '')
        && d.public is bool
        && d.totalSeconds is int && d.weekSeconds is int && d.streakDays is int
        && d.instantUntil is timestamp && d.scheduleDay is timestamp
        && d.updatedAt == request.time;
    }
    function weekBase(n, o) {
      return n.weekKey == o.weekKey ? o.weekSeconds : 0;
    }
    // No new time: profile refresh, visibility toggle, week rollover.
    function statsRefresh(n, o) {
      return n.totalSeconds == o.totalSeconds && n.weekSeconds == weekBase(n, o)
        && n.streakDays == o.streakDays && n.instantUntil == o.instantUntil && n.scheduleDay == o.scheduleDay;
    }
    // Finished instant brick, counted once for its exact duration.
    function instantClaim(n, o, l) {
      let delta = n.totalSeconds - o.totalSeconds;
      return l.self.until > o.instantUntil && l.self.until <= request.time
        && n.instantUntil == l.self.until && n.scheduleDay == o.scheduleDay && n.streakDays == o.streakDays
        && delta == (l.self.until - l.self.get('since', l.self.until)).seconds()
        && n.weekSeconds == weekBase(n, o) + delta;
    }
    // A whole past day of scheduled time, on a day the schedule didn't change.
    function dayClaim(n, o, l) {
      let lt = n.scheduleDay + duration.value(l.tzOffset, 'm');
      let delta = n.totalSeconds - o.totalSeconds;
      return n.scheduleDay > o.scheduleDay
        && lt.hours() == 0 && lt.minutes() == 0 && lt.seconds() == 0
        && n.scheduleDay + duration.value(1, 'd') <= request.time
        && n.scheduleDay >= l.get('slotsChangedAt', request.time)
        && n.instantUntil == o.instantUntil
        && delta == l.self.slots.get('d' + string(lt.dayOfWeek()), []).size() * 1800
        && delta > 0
        && n.weekSeconds == weekBase(n, o) + delta
        && n.streakDays == (n.scheduleDay == o.scheduleDay + duration.value(1, 'd') ? o.streakDays + 1 : 1);
    }
    match /brickStats/{uid} {
      allow get: if resource.data.public == true || isUser(uid);
      allow list: if resource.data.public == true;
      // Starts at zero; nothing before creation counts.
      allow create: if isUser(uid) && statsShapeOk(incomingData())
        && incomingData().totalSeconds == 0 && incomingData().weekSeconds == 0 && incomingData().streakDays == 0
        && incomingData().weekKey == weekKeyOf(statsLock())
        && incomingData().instantUntil == statsLock().self.until
        && incomingData().scheduleDay <= request.time
        && incomingData().scheduleDay > request.time - duration.value(1, 'd');
      allow update: if isUser(uid) && statsShapeOk(incomingData())
        && incomingData().weekKey == weekKeyOf(statsLock())
        && (statsRefresh(incomingData(), resource.data)
            || instantClaim(incomingData(), resource.data, statsLock())
            || dayClaim(incomingData(), resource.data, statsLock()));
      allow delete: if isUser(uid);
    }

    // Posts
    match /posts/{postId} {
      // Authors can always read their own posts, even when bricked.
      allow get: if (guest() && resource.data.visibility == 'public')
        || (signedIn() && canReadPost(resource.data)
            && (resource.data.authorId == request.auth.uid || !lockedFor(sectionOfKind(resource.data.kind))));

      function votedNow(option) {
        return resource.data.get('poll', null) != null
          && request.time < resource.data.poll.endsAt
          && option < resource.data.poll.options.size()
          && canReadPost(resource.data)
          && !exists(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/posts/$(postId)/votes/$(request.auth.uid)).data.option == option;
      }

      // List queries are checked statically: callers must constrain
      // visibility == 'public' or authorId == uid (or groupId for circles), so
      // followers-only posts are only reachable via get. Only full locks apply
      // here, since one query can mix formats.
      allow list: if (guest() && resource.data.visibility == 'public')
        || (signedIn()
          && (resource.data.visibility == 'public'
              || resource.data.authorId == request.auth.uid
              || (resource.data.visibility == 'circle' && isMemberOf(resource.data.groupId))
              || (resource.data.visibility == 'pending' && isModOf(resource.data.groupId)))
          && (resource.data.authorId == request.auth.uid || !lockedFor('')));
      allow create: if signedIn()
        && postCreateOk(request.resource.data,
             request.resource.data.get('groupId', '') != '' && isModOf(request.resource.data.get('groupId', '')));
      allow update: if signedIn() && (
        // Authors edit non-circle posts (circle edits could bypass limits). Text
        // changes stamp editedAt and are rate-limited; visibility changes aren't.
        (resource.data.authorId == request.auth.uid
          && resource.data.get('groupId', '') == ''
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['text', 'title', 'alt', 'visibility', 'aiGenerated', 'sensitive', 'topics', 'location', 'editedAt'])
          && (!incomingData().diff(resource.data).affectedKeys().hasAny(['text', 'title', 'alt', 'topics', 'sensitive', 'location', 'editedAt'])
              || (incomingData().editedAt == request.time && rateOk('edit', 3) && notSuspended()))
          && validTopics(incomingData().get('topics', []))
          && incomingData().visibility in ['public', 'followers']
          && (incomingData().visibility == 'followers'
              || (isAdult() && myProfile().get('isPrivate', false) != true))
          && incomingData().text is string
          && incomingData().text.size() <= 5000
          && incomingData().title is string && incomingData().title.size() <= 150
          && incomingData().alt is string && incomingData().alt.size() <= 500
          && incomingData().get('aiGenerated', false) is bool
          && incomingData().get('sensitive', false) is bool
          && (incomingData().get('sensitive', false) == true
              || hateFree(incomingData().text + ' ' + incomingData().title + ' ' + incomingData().alt + ' ' + incomingData().get('location', '')))
          && incomingData().get('location', '') is string && incomingData().get('location', '').size() <= 60
          && (resource.data.kind != 'text' || incomingData().text.size() <= 500))
        // +1 per first report, from accounts older than a day.
        || (onlyKey('reportCount')
          && incomingData().reportCount == resource.data.get('reportCount', 0) + 1
          && getAfter(/databases/$(database)/documents/posts/$(postId)).data.reportCount == incomingData().reportCount
          && resource.data.authorId != request.auth.uid
          && !exists(/databases/$(database)/documents/reports/$('post_' + postId + '_' + request.auth.uid))
          && existsAfter(/databases/$(database)/documents/reports/$('post_' + postId + '_' + request.auth.uid))
          && myProfile().createdAt < request.time - duration.value(1, 'd'))
        // Moderator review clears the hold.
        || (isAdmin() && onlyKey('modStatus') && incomingData().modStatus in ['cleared', ''])
        // Circle mods can lock comments on a thread.
        || (onlyKey('locked')
          && resource.data.get('groupId', '') != ''
          && isModOf(resource.data.groupId)
          && incomingData().locked is bool)
        // ...and approve pending posts.
        || (onlyKey('visibility')
          && resource.data.visibility == 'pending'
          && isModOf(resource.data.groupId)
          && ((circleOf(resource.data.groupId).privacy == 'public' && incomingData().visibility == 'public')
              || (circleOf(resource.data.groupId).privacy != 'public' && incomingData().visibility == 'circle')))
        // Counts move only with the record they count (tiedCount).
        || (onlyKey('likeCount') && tiedCount(/databases/$(database)/documents/posts/$(postId), 'likeCount',
              /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)))
        || (onlyKey('saveCount') && tiedCount(/databases/$(database)/documents/posts/$(postId), 'saveCount',
              /databases/$(database)/documents/posts/$(postId)/saves/$(request.auth.uid)))
        || (onlyKey('sendCount') && tiedCount(/databases/$(database)/documents/posts/$(postId), 'sendCount',
              /databases/$(database)/documents/posts/$(postId)/sends/$(request.auth.uid)))
        || (onlyKey('repostCount') && tiedCount(/databases/$(database)/documents/posts/$(postId), 'repostCount',
              /databases/$(database)/documents/reposts/$(postId + '_' + request.auth.uid)))
        || (incomingData().diff(resource.data).affectedKeys().hasOnly(['commentCount', 'lastCommentId'])
          && incomingData().lastCommentId is string
          && tiedCount(/databases/$(database)/documents/posts/$(postId), 'commentCount',
              /databases/$(database)/documents/posts/$(postId)/comments/$(incomingData().lastCommentId)))
        // Poll totals move only with the voter's first vote.
        || (onlyKey('pollVotes0') && incomingData().pollVotes0 == resource.data.get('pollVotes0', 0) + 1 && votedNow(0))
        || (onlyKey('pollVotes1') && incomingData().pollVotes1 == resource.data.get('pollVotes1', 0) + 1 && votedNow(1))
        || (onlyKey('pollVotes2') && incomingData().pollVotes2 == resource.data.get('pollVotes2', 0) + 1 && votedNow(2))
        || (onlyKey('pollVotes3') && incomingData().pollVotes3 == resource.data.get('pollVotes3', 0) + 1 && votedNow(3))
      );
      // Authors, or circle mods for posts in their circle.
      allow delete: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || (resource.data.get('groupId', '') != '' && isModOf(resource.data.groupId))
        || isAdmin()
      );

      // Votes are private to the voter and final.
      match /votes/{uid} {
        function postNow() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        function postAfter() {
          return getAfter(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if isUser(uid);
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['option', 'createdAt'])
          && incomingData().option is int
          && ((incomingData().option == 0 && postAfter().pollVotes0 == postNow().get('pollVotes0', 0) + 1)
              || (incomingData().option == 1 && postAfter().pollVotes1 == postNow().get('pollVotes1', 0) + 1)
              || (incomingData().option == 2 && postAfter().pollVotes2 == postNow().get('pollVotes2', 0) + 1)
              || (incomingData().option == 3 && postAfter().pollVotes3 == postNow().get('pollVotes3', 0) + 1));
        allow update, delete: if false;
      }

      match /likes/{uid} {
        allow read: if (guest() && get(/databases/$(database)/documents/posts/$(postId)).data.visibility == 'public')
          || (signedIn() && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data));
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['username', 'createdAt'])
          && isMyName(incomingData().username)
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow update: if false;
        allow delete: if isUser(uid);
      }
      // One per sender; sendCount counts distinct senders.
      match /sends/{uid} {
        allow read: if isUser(uid);
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['createdAt'])
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow update, delete: if false;
      }

      // Private; rewriting one's own save is allowed (idempotent).
      match /saves/{uid} {
        allow read: if isUser(uid);
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['createdAt'])
          && canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
        allow update: if false;
        allow delete: if isUser(uid);
      }

      // Comments inherit post visibility; locked threads take no new comments.
      match /comments/{commentId} {
        function parentPost() {
          return get(/databases/$(database)/documents/posts/$(postId)).data;
        }
        allow read: if (guest() && parentPost().visibility == 'public')
          || (signedIn() && canReadPost(parentPost()) && !lockedFor(''));
        allow create: if signedIn()
          && incomingData().keys().hasOnly(['authorId', 'authorName', 'authorDisplayName', 'authorPhoto', 'text', 'gif', 'sensitive', 'createdAt'])
          && authorIsMe(incomingData())
          && incomingData().createdAt == request.time
          && rateOk('comment', 3)
          && incomingData().get('sensitive', false) is bool
          && incomingData().text is string
          && incomingData().text.size() <= 2000
          && (incomingData().text.size() > 0 || 'gif' in incomingData())
          && (!('gif' in incomingData()) || gifOk(incomingData().gif))
          && (incomingData().get('sensitive', false) == true || hateFree(incomingData().text))
          && notSuspended()
          && canReadPost(parentPost())
          && parentPost().get('locked', false) != true
          // commentPolicy: everyone | following | nobody; blocked users never.
          && (parentPost().authorId == request.auth.uid
              || (!blockedBy(parentPost().authorId)
                  && (profileOf(parentPost().authorId).get('commentPolicy', 'everyone') == 'everyone'
                      || (profileOf(parentPost().authorId).get('commentPolicy', 'everyone') == 'following'
                          && follows(parentPost().authorId, request.auth.uid)))));
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid
              || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
              || isAdmin());
      }
    }

    // Calls (WebRTC signalling only)
    match /calls/{callId} {
      function party(c) {
        return request.auth.uid == c.callerId || request.auth.uid == c.calleeId;
      }
      function callNow() {
        return get(/databases/$(database)/documents/calls/$(callId)).data;
      }
      // Callee answers/declines/busies; caller cancels; either ends.
      function callStatusOk(before, after) {
        return after == before
          || (before == 'ringing' && after in ['active', 'declined', 'busy'] && request.auth.uid == resource.data.calleeId)
          || (before == 'ringing' && after == 'missed' && request.auth.uid == resource.data.callerId)
          || (before in ['ringing', 'active'] && after == 'ended');
      }
      function changed() {
        return incomingData().diff(resource.data).affectedKeys();
      }
      allow get: if signedIn() && party(resource.data);
      allow list: if signedIn()
        && (resource.data.calleeId == request.auth.uid || resource.data.callerId == request.auth.uid);
      // Only a follower sharing a 1:1 chat, and not blocked, can ring someone.
      allow create: if signedIn()
        && incomingData().keys().hasOnly(['callerId', 'callerName', 'callerPhoto', 'calleeId', 'chatId', 'video', 'status', 'offer', 'offerRev', 'createdAt'])
        && incomingData().get('offerRev', 0) == 0
        && incomingData().callerId == request.auth.uid
        && isMyName(incomingData().callerName)
        && isMyPhoto(incomingData().callerPhoto)
        && incomingData().calleeId != request.auth.uid
        && incomingData().status == 'ringing'
        && incomingData().video is bool
        && incomingData().createdAt == request.time
        && get(/databases/$(database)/documents/chats/$(incomingData().chatId)).data.get('isGroup', false) != true
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(incomingData().chatId)).data.members
        && incomingData().calleeId in get(/databases/$(database)/documents/chats/$(incomingData().chatId)).data.members
        && follows(incomingData().calleeId, request.auth.uid)
        && !blockedBy(incomingData().calleeId);
      // Only the callee answers. ICE restarts: the caller increments offerRev and
      // answers must match the current offerRev.
      allow update: if signedIn() && party(resource.data)
        && changed().hasOnly(['answer', 'answerRev', 'offer', 'offerRev', 'status', 'answeredAt', 'endedAt'])
        && callStatusOk(resource.data.status, incomingData().status)
        && (!changed().hasAny(['answer', 'answerRev'])
            || (request.auth.uid == resource.data.calleeId
                && incomingData().get('answerRev', 0) == incomingData().get('offerRev', 0)))
        && (!changed().hasAny(['offer', 'offerRev'])
            || (request.auth.uid == resource.data.callerId && resource.data.status == 'active'
                && incomingData().offerRev == resource.data.get('offerRev', 0) + 1));
      // Signalling (including IPs) is deletable once the call has ended.
      allow delete: if signedIn() && party(resource.data)
        && resource.data.status in ['declined', 'busy', 'missed', 'ended'];

      match /callerCandidates/{candidateId} {
        allow read: if signedIn() && party(callNow());
        allow create: if signedIn() && request.auth.uid == callNow().callerId;
        allow delete: if signedIn() && party(callNow()) && callNow().status in ['declined', 'busy', 'missed', 'ended'];
        allow update: if false;
      }
      match /calleeCandidates/{candidateId} {
        allow read: if signedIn() && party(callNow());
        allow create: if signedIn() && request.auth.uid == callNow().calleeId;
        allow delete: if signedIn() && party(callNow()) && callNow().status in ['declined', 'busy', 'missed', 'ended'];
        allow update: if false;
      }
    }

    // Inline media (Spark plan): get by id only, never listed.
    match /media/{mediaId} {
      allow get: if true;
      // Owner only, for account deletion.
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && incomingData().keys().hasOnly(['ownerId', 'kind', 'data', 'width', 'height', 'createdAt'])
        && incomingData().ownerId == request.auth.uid
        && rateOk('media', 5)
        && incomingData().kind == 'image'
        && incomingData().data is string
        && incomingData().data.size() <= 900000
        && incomingData().data.matches('^data:image/(webp|jpeg|png);base64,.*$');
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Reposts: id `{postId}_{uid}`; only others' public posts.
    match /reposts/{repostId} {
      allow read: if true;
      allow create: if signedIn()
        && incomingData().keys().hasOnly(['postId', 'postAuthorId', 'uid', 'username', 'createdAt'])
        && incomingData().uid == request.auth.uid
        && isMyName(incomingData().username)
        && repostId == incomingData().postId + '_' + request.auth.uid
        && incomingData().createdAt == request.time
        && get(/databases/$(database)/documents/posts/$(incomingData().postId)).data.visibility == 'public'
        && get(/databases/$(database)/documents/posts/$(incomingData().postId)).data.authorId != request.auth.uid
        && get(/databases/$(database)/documents/posts/$(incomingData().postId)).data.authorId == incomingData().postAuthorId;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Stories (clients filter to the last 24h). Followers-only for private accounts.
    match /stories/{storyId} {
      allow get: if signedIn()
        && (resource.data.get('audience', 'public') == 'public'
            || resource.data.authorId == request.auth.uid
            || exists(/databases/$(database)/documents/users/$(resource.data.authorId)/followers/$(request.auth.uid)))
        && !lockedFor('feed');
      allow list: if signedIn()
        && (resource.data.audience == 'public'
            || resource.data.authorId == request.auth.uid
            || exists(/databases/$(database)/documents/users/$(resource.data.authorId)/followers/$(request.auth.uid)))
        && !lockedFor('feed');
      allow create: if signedIn()
        && incomingData().keys().hasOnly([
          'authorId', 'authorName', 'authorDisplayName', 'authorPhoto', 'mediaUrl', 'mediaPath', 'mediaType',
          'audience', 'day', 'createdAt'
        ])
        && incomingData().day is string
        && incomingData().day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && authorIsMe(incomingData())
        && incomingData().createdAt == request.time
        && incomingData().get('mediaType', '') is string && incomingData().get('mediaType', '').size() <= 100
        && incomingData().get('mediaPath', '') is string && incomingData().get('mediaPath', '').size() <= 500
        && incomingData().audience in ['public', 'followers']
        && notSuspended()
        && (incomingData().audience == 'followers' || myProfile().get('isPrivate', false) != true)
        && (incomingData().mediaUrl.matches('^https://firebasestorage[.]googleapis[.]com/.*')
            || ownInlineImage(incomingData().mediaUrl));
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      function storyNow() {
        return get(/databases/$(database)/documents/stories/$(storyId)).data;
      }
      function canSeeStory(s) {
        return signedIn()
          && (s.get('audience', 'public') == 'public'
              || s.authorId == request.auth.uid
              || exists(/databases/$(database)/documents/users/$(s.authorId)/followers/$(request.auth.uid)))
          && !lockedFor('feed');
      }
      function storyLive(s) {
        return s.createdAt > request.time - duration.value(24, 'h');
      }

      // Likes: visible to the story author only.
      match /likes/{uid} {
        allow get: if isUser(uid) || (signedIn() && storyNow().authorId == request.auth.uid);
        allow list: if signedIn() && storyNow().authorId == request.auth.uid;
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['username', 'createdAt'])
          && isMyName(incomingData().username)
          && incomingData().createdAt == request.time
          && storyNow().authorId != request.auth.uid
          && canSeeStory(storyNow()) && storyLive(storyNow())
          && !blockedBy(storyNow().authorId)
          && notSuspended();
        allow update: if false;
        allow delete: if isUser(uid) || (signedIn() && storyNow().authorId == request.auth.uid);
      }

      // Views: one per viewer, visible to the author only.
      match /views/{uid} {
        allow get: if isUser(uid) || (signedIn() && storyNow().authorId == request.auth.uid);
        allow list: if signedIn() && storyNow().authorId == request.auth.uid;
        allow create: if isUser(uid)
          && incomingData().keys().hasOnly(['username', 'createdAt'])
          && isMyName(incomingData().username)
          && incomingData().createdAt == request.time
          && storyNow().authorId != request.auth.uid
          && canSeeStory(storyNow()) && storyLive(storyNow());
        allow update: if false;
        allow delete: if isUser(uid) || (signedIn() && storyNow().authorId == request.auth.uid);
      }

      // Echoes: public replies, held to the comment rules (hate filter, rate
      // limit, blocks, commentPolicy), only while the story is live.
      match /echoes/{echoId} {
        allow read: if canSeeStory(storyNow());
        allow create: if signedIn()
          && incomingData().keys().hasOnly(['authorId', 'authorName', 'authorDisplayName', 'authorPhoto', 'text', 'createdAt'])
          && authorIsMe(incomingData())
          && incomingData().createdAt == request.time
          && rateOk('comment', 3)
          && incomingData().text is string
          && incomingData().text.size() > 0 && incomingData().text.size() <= 300
          && hateFree(incomingData().text)
          && notSuspended()
          && echoAllowed(storyNow());
        allow update: if false;
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || storyNow().authorId == request.auth.uid || isAdmin());
      }
      function echoAllowed(s) {
        return canSeeStory(s) && storyLive(s)
          && (s.authorId == request.auth.uid
              || (!blockedBy(s.authorId)
                  && (profileOf(s.authorId).get('commentPolicy', 'everyone') == 'everyone'
                      || (profileOf(s.authorId).get('commentPolicy', 'everyone') == 'following'
                          && follows(s.authorId, request.auth.uid)))));
      }
    }

    // News. Only approved writers create stories (private drafts for up to
    // four author-writers). Saves increment `version` by one, so concurrent
    // saves are detected and merged client-side. Only reviewers publish, and
    // never under legal hold. The body is parallel block arrays; `script` must
    // equal the texts joined by blank lines.
    function isNewsWriter() {
      return signedIn() && exists(/databases/$(database)/documents/newsWriters/$(request.auth.uid));
    }
    function writerExists(list, i) {
      return list.size() <= i || exists(/databases/$(database)/documents/newsWriters/$(list[i]));
    }
    function storyBlocksOk(d) {
      let ids = d.get('blockIds', []);
      return ids is list && ids.size() <= 150
        && d.get('blockTypes', []).size() == ids.size()
        && d.get('blockTexts', []).size() == ids.size()
        && d.get('blockMedia', []).size() == ids.size()
        && d.get('blockAlts', []).size() == ids.size()
        && d.get('blockTypes', []).hasOnly(['p', 'h2', 'h3', 'quote', 'list', 'image', 'divider'])
        && d.get('blockMedia', []).join(' ').matches('^((https://firebasestorage[.]googleapis[.]com/[^ ]+|mesh-media:[A-Za-z0-9_-]+)? ?)*$')
        && d.get('blockAlts', []).join(' ').size() <= 5000
        && d.script == d.get('blockTexts', []).join('\n\n');
    }
    function storyContentOk(d) {
      return d.title is string && d.title.size() <= 200
        && d.get('standfirst', '') is string && d.get('standfirst', '').size() <= 300
        && d.get('topic', 'world') in newsTopicIds()
        && d.get('location', '') is string && d.get('location', '').size() <= 80
        && d.get('keyPoints', []) is list && d.get('keyPoints', []).size() <= 3
        && keyPointOk(d.get('keyPoints', []), 0) && keyPointOk(d.get('keyPoints', []), 1) && keyPointOk(d.get('keyPoints', []), 2)
        && (d.get('coverUrl', '') == ''
            || d.coverUrl.matches('^(https://firebasestorage[.]googleapis[.]com/.*|mesh-media:[A-Za-z0-9_-]+)$'))
        && d.script is string && d.script.size() <= 40000
        && d.sources is list && d.sources.size() <= 10 && newsSourcesOk(d.sources)
        && d.get('format', 'story') in ['story', 'live']
        && d.get('legalHold', false) is bool
        && d.get('legalNote', '') is string && d.get('legalNote', '').size() <= 300
        && storyBlocksOk(d)
        && hateFree(d.title + ' ' + d.get('standfirst', '') + ' ' + d.script + ' '
                    + d.get('keyPoints', []).join(' ') + ' ' + d.get('blockAlts', []).join(' '));
    }
    // Submittable: headline, body, two or more sources, and an accuracy attestation.
    function readyForReview(d) {
      return d.title.size() >= 10 && d.script.size() >= 100 && d.sources.size() >= 2
        && d.attestedAt == request.time && d.submittedAt == request.time;
    }
    function isStoryAuthor(d) {
      return d.authorId == request.auth.uid || request.auth.uid in d.get('authors', []);
    }

    match /newsWriters/{uid} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && incomingData().keys().hasOnly(['username', 'addedBy', 'addedAt'])
        && incomingData().username == profileOf(uid).username
        && incomingData().addedBy == request.auth.uid
        && incomingData().addedAt == request.time;
      allow delete: if isAdmin() || isUser(uid);
    }

    match /news/{newsId} {
      // Approved: everyone (unless News is locked). Drafts: authors. Submitted: reviewers too.
      allow read: if (guest() && resource.data.status == 'approved')
        || signedIn()
        && ((resource.data.status == 'approved' && !lockedFor('news'))
            || resource.data.authorId == request.auth.uid
            || request.auth.uid in resource.data.authors
            || (resource.data.status != 'draft' && isAdmin()));
      allow create: if isNewsWriter()
        && incomingData().keys().hasOnly([
          'authorId', 'authorName', 'authors', 'authorNames', 'title', 'standfirst', 'script', 'sources',
          'topic', 'keyPoints', 'location', 'coverUrl', 'format', 'live', 'legalHold', 'legalNote',
          'blockIds', 'blockTypes', 'blockTexts', 'blockMedia', 'blockAlts',
          'corrections', 'status', 'reviewNote', 'likeCount', 'commentCount', 'version', 'createdAt', 'updatedAt'
        ])
        && incomingData().authorId == request.auth.uid
        && isMyName(incomingData().authorName)
        && incomingData().authors == [request.auth.uid]
        && incomingData().authorNames == [incomingData().authorName]
        && incomingData().status == 'draft'
        && incomingData().version == 1
        && incomingData().live == false
        && incomingData().createdAt == request.time
        && incomingData().updatedAt == request.time
        && incomingData().corrections == []
        && incomingData().reviewNote == ''
        && incomingData().likeCount == 0 && incomingData().commentCount == 0
        && storyContentOk(incomingData())
        && notSuspended()
        && isAdult();
      allow update: if
        // Author saves and submission.
        (isNewsWriter()
          && isStoryAuthor(resource.data)
          && resource.data.status in ['draft', 'rejected']
          && incomingData().diff(resource.data).affectedKeys().hasOnly([
               'title', 'standfirst', 'script', 'sources', 'topic', 'keyPoints', 'location', 'coverUrl', 'format',
               'legalHold', 'legalNote', 'blockIds', 'blockTypes', 'blockTexts', 'blockMedia', 'blockAlts',
               'authors', 'authorNames', 'status', 'submittedAt', 'attestedAt', 'version', 'updatedAt'])
          && incomingData().version == resource.data.version + 1
          && incomingData().updatedAt == request.time
          // Only the lead edits co-authors, and all authors must be writers.
          && incomingData().authors[0] == resource.data.authorId
          && (incomingData().authors == resource.data.authors
              || (request.auth.uid == resource.data.authorId
                  && incomingData().authors.size() <= 4
                  && incomingData().authorNames.size() == incomingData().authors.size()
                  && writerExists(incomingData().authors, 1) && writerExists(incomingData().authors, 2)
                  && writerExists(incomingData().authors, 3)))
          && storyContentOk(incomingData())
          && notSuspended()
          && (incomingData().status == resource.data.status
              || (resource.data.status == 'rejected' && incomingData().status == 'draft')
              || (incomingData().status == 'pending' && readyForReview(incomingData()))))
        // Reviewers approve, reject or send back; approval is blocked under legal hold.
        || (isAdmin()
          && resource.data.status == 'pending'
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNote', 'reviewedBy', 'reviewedAt'])
          && incomingData().status in ['approved', 'rejected', 'draft']
          && (incomingData().status != 'approved' || resource.data.get('legalHold', false) != true))
        || (isAdmin()
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['legalHold', 'legalNote'])
          && incomingData().legalHold == false)
        // Corrections are append-only.
        || (isAdmin()
          && resource.data.status == 'approved'
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['corrections'])
          && incomingData().corrections.size() == resource.data.get('corrections', []).size() + 1)
        || (isStoryAuthor(resource.data)
          && resource.data.status == 'approved'
          && resource.data.get('format', 'story') == 'live'
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['live', 'updatedAt'])
          && incomingData().live is bool
          && incomingData().updatedAt == request.time);
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Per-block editing presence.
      match /presence/{uid} {
        allow read: if signedIn() && isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data);
        allow create, update: if isUser(uid)
          && isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data)
          && incomingData().keys().hasOnly(['blockId', 'username', 'at'])
          && incomingData().blockId is string && incomingData().blockId.size() <= 40
          && isMyName(incomingData().username)
          && incomingData().at == request.time;
        allow delete: if isUser(uid) || (signedIn() && !existsAfter(/databases/$(database)/documents/news/$(newsId))
          && (isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data) || isAdmin()));
      }

      // Immutable revisions.
      match /revisions/{revisionId} {
        allow read: if signedIn()
          && (isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data) || isAdmin());
        allow create: if isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data)
          && incomingData().keys().hasOnly(['title', 'standfirst', 'script', 'blockIds', 'blockTypes', 'blockTexts',
                                            'blockMedia', 'blockAlts', 'sources', 'version', 'note', 'by', 'byName', 'at'])
          && incomingData().by == request.auth.uid
          && isMyName(incomingData().byName)
          && incomingData().at == request.time
          && incomingData().note is string && incomingData().note.size() <= 200
          && incomingData().script is string && incomingData().script.size() <= 40000
          && incomingData().blockIds is list && incomingData().blockIds.size() <= 150;
        allow update: if false;
        allow delete: if signedIn() && !existsAfter(/databases/$(database)/documents/news/$(newsId))
          && (isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data) || isAdmin());
      }

      // Live blog updates: authors post while live.
      match /updates/{updateId} {
        allow read: if get(/databases/$(database)/documents/news/$(newsId)).data.status == 'approved'
          && (guest() || !lockedFor('news'));
        allow create: if isNewsWriter()
          && isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data)
          && get(/databases/$(database)/documents/news/$(newsId)).data.status == 'approved'
          && get(/databases/$(database)/documents/news/$(newsId)).data.get('format', 'story') == 'live'
          && get(/databases/$(database)/documents/news/$(newsId)).data.get('live', false) == true
          && incomingData().keys().hasOnly(['text', 'by', 'byName', 'at', 'key'])
          && incomingData().by == request.auth.uid
          && isMyName(incomingData().byName)
          && incomingData().at == request.time
          && incomingData().text is string && incomingData().text.size() >= 1 && incomingData().text.size() <= 1500
          && incomingData().key is bool
          && hateFree(incomingData().text)
          && notSuspended();
        allow delete: if isStoryAuthor(get(/databases/$(database)/documents/news/$(newsId)).data) || isAdmin();
      }

      // Correction requests: readable by reviewers only.
      match /correctionRequests/{requestId} {
        allow read, delete: if isAdmin();
        allow create: if signedIn()
          && get(/databases/$(database)/documents/news/$(newsId)).data.status == 'approved'
          && incomingData().keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && incomingData().authorId == request.auth.uid
          && isMyName(incomingData().authorName)
          && incomingData().createdAt == request.time
          && incomingData().text is string
          && incomingData().text.size() >= 10
          && incomingData().text.size() <= 1000
          && hateFree(incomingData().text);
        allow update: if false;
      }
    }

    // Chats
    match /chats/{chatId} {
      function chatData() {
        return get(/databases/$(database)/documents/chats/$(chatId)).data;
      }
      function inChat() {
        return signedIn() && request.auth.uid in chatData().members;
      }
      function storyReplyOk(r) {
        let story = get(/databases/$(database)/documents/stories/$(r.id)).data;
        return r.keys().hasOnly(['id', 'authorId', 'mediaUrl', 'mediaType'])
          && story.authorId == r.authorId
          && story.mediaUrl == r.mediaUrl
          && story.get('mediaType', '') == r.mediaType
          && r.authorId in chatData().members;
      }
      function onlyMyKeyIn(field) {
        return incomingData()[field].diff(resource.data[field]).affectedKeys()
          .hasOnly([request.auth.uid]);
      }

      function groupAdmins() {
        return resource.data.get('admins', [resource.data.createdBy]);
      }
      function changed() {
        return incomingData().diff(resource.data).affectedKeys();
      }
      function blockedInDm() {
        let m = chatData().members;
        return chatData().get('isGroup', false) != true
          && ((m[0] == request.auth.uid && blockedBy(m[1]))
              || (m[1] == request.auth.uid && blockedBy(m[0])));
      }

      // Tolerate gets on non-existent chats.
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      // 1:1 chats use the sorted uid pair as id and require reachability. Groups
      // start with the creator as admin; members are added one write at a time.
      allow create: if signedIn()
        && request.auth.uid in incomingData().members
        && incomingData().name is string
        && incomingData().name.size() <= 60
        && notSuspended()
        // No pre-set pins/mutes or previews; member names must match profiles.
        && incomingData().get('pinnedBy', []) == []
        && incomingData().get('mutedBy', []) == []
        && incomingData().get('nicknames', {}) == {}
        && incomingData().get('lastMessage', '') == ''
        && incomingData().get('lastSenderId', '') == ''
        && incomingData().get('createdBy', request.auth.uid) == request.auth.uid
        && incomingData().get('theme', 'default') in ['default', 'ocean', 'sunset', 'forest', 'mono']
        && incomingData().memberNames.keys().hasOnly(incomingData().members)
        && incomingData().memberNames[request.auth.uid] == myProfile().username
        && ((incomingData().isGroup == false
              && incomingData().members.size() == 2
              && chatId == incomingData().members[0] + '_' + incomingData().members[1]
              && incomingData().members[0] != incomingData().members[1]
              && incomingData().memberNames[incomingData().members[0]] == profileOf(incomingData().members[0]).username
              && incomingData().memberNames[incomingData().members[1]] == profileOf(incomingData().members[1]).username
              && ((incomingData().members[0] == request.auth.uid && reachable(incomingData().members[1]))
                  || (incomingData().members[1] == request.auth.uid && reachable(incomingData().members[0]))))
            || (incomingData().isGroup == true
              && incomingData().members == [request.auth.uid]
              && incomingData().get('admins', []) == [request.auth.uid]));
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && (
          (request.auth.uid in incomingData().members
            && changed().hasOnly(['lastMessage', 'lastSenderId', 'updatedAt', 'theme', 'nicknames', 'name'])
            && incomingData().name is string
            && incomingData().name.size() <= 60
            && incomingData().get('lastMessage', '') is string
            && incomingData().get('lastMessage', '').size() <= 200
            // Preview is the caller's and stamped now.
            && (!changed().hasAny(['lastSenderId']) || incomingData().lastSenderId == request.auth.uid)
            && (!changed().hasAny(['updatedAt']) || incomingData().updatedAt == request.time)
            && incomingData().get('theme', 'default') in ['default', 'ocean', 'sunset', 'forest', 'mono'])
          || (changed().hasOnly(['pinnedBy'])
              && incomingData().pinnedBy.toSet().difference(resource.data.get('pinnedBy', []).toSet())
                   .union(resource.data.get('pinnedBy', []).toSet().difference(incomingData().pinnedBy.toSet()))
                   .hasOnly([request.auth.uid]))
          || (changed().hasOnly(['mutedBy'])
              && incomingData().mutedBy.toSet().difference(resource.data.get('mutedBy', []).toSet())
                   .union(resource.data.get('mutedBy', []).toSet().difference(incomingData().mutedBy.toSet()))
                   .hasOnly([request.auth.uid]))
          // Add one member to a group; the new member must be reachable and correctly named.
          || (resource.data.get('isGroup', false) == true
              && changed().hasOnly(['members', 'memberNames'])
              && incomingData().members.size() == resource.data.members.size() + 1
              && incomingData().members.size() <= 250
              && incomingData().members[0:resource.data.members.size()] == resource.data.members
              && !(incomingData().members[incomingData().members.size() - 1] in resource.data.members)
              && reachable(incomingData().members[incomingData().members.size() - 1])
              && incomingData().memberNames.diff(resource.data.get('memberNames', {})).affectedKeys()
                   .hasOnly([incomingData().members[incomingData().members.size() - 1]])
              && incomingData().memberNames[incomingData().members[incomingData().members.size() - 1]]
                   == profileOf(incomingData().members[incomingData().members.size() - 1]).username)
          // Leave: remove only oneself; a leaving admin may hand over the role.
          || (resource.data.get('isGroup', false) == true
              && changed().hasOnly(['members', 'memberNames', 'admins'])
              && resource.data.members.toSet().difference(incomingData().members.toSet()) == [request.auth.uid].toSet()
              && incomingData().members.toSet().difference(resource.data.members.toSet()).size() == 0
              && incomingData().get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys()
                   .difference([request.auth.uid].toSet()).size() == 0
              && ((request.auth.uid in groupAdmins()
                    && incomingData().get('admins', []).toSet().difference(incomingData().members.toSet()).size() == 0)
                  || (!(request.auth.uid in groupAdmins())
                    && incomingData().get('admins', []) == resource.data.get('admins', []))))
          || (resource.data.get('isGroup', false) == true
              && request.auth.uid in groupAdmins()
              && request.auth.uid in incomingData().members
              && changed().hasOnly(['members', 'memberNames', 'admins'])
              && incomingData().members.toSet().difference(resource.data.members.toSet()).size() == 0
              && incomingData().get('admins', []).toSet().difference(incomingData().members.toSet()).size() == 0
              && incomingData().get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys()
                   .difference(resource.data.members.toSet().difference(incomingData().members.toSet())).size() == 0)
        );
      // Circle chats: circle members may add themselves.
      allow update: if signedIn()
        && resource.data.get('circleId', '') != ''
        && isMemberOf(resource.data.circleId)
        && circleOf(resource.data.circleId).get('chatId', '') == chatId
        && !(request.auth.uid in resource.data.members)
        && changed().hasOnly(['members', 'memberNames'])
        && incomingData().members.size() == resource.data.members.size() + 1
        && incomingData().members.size() <= 1000
        && (resource.data.members.size() == 0
            || incomingData().members[0:resource.data.members.size()] == resource.data.members)
        && incomingData().members[incomingData().members.size() - 1] == request.auth.uid
        && incomingData().memberNames.diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
        && incomingData().memberNames[request.auth.uid] == myProfile().username;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;

      match /messages/{messageId} {
        allow read: if inChat();
        allow create: if inChat()
          && incomingData().keys().hasOnly(['senderId', 'text', 'reactions', 'createdAt', 'replyTo', 'sharedPost', 'gif', 'voice', 'photo', 'poll', 'call', 'storyReply'])
          && incomingData().senderId == request.auth.uid
          && incomingData().createdAt == request.time
          && incomingData().reactions == {}
          && incomingData().text is string
          && incomingData().text.size() <= 2000
          // Quoted replies, shared-post previews and voice notes must match their sources.
          && (!('replyTo' in incomingData())
              || (get(/databases/$(database)/documents/chats/$(chatId)/messages/$(incomingData().replyTo.id)).data.senderId == incomingData().replyTo.senderId
                  && incomingData().replyTo.text is string
                  && incomingData().replyTo.text.size() <= 90
                  && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(incomingData().replyTo.id)).data.text[0:incomingData().replyTo.text.size()] == incomingData().replyTo.text))
          && (!('sharedPost' in incomingData())
              || (get(/databases/$(database)/documents/posts/$(incomingData().sharedPost.id)).data.authorName == incomingData().sharedPost.authorName
                  && get(/databases/$(database)/documents/posts/$(incomingData().sharedPost.id)).data.get('title', '') == incomingData().sharedPost.title
                  && get(/databases/$(database)/documents/posts/$(incomingData().sharedPost.id)).data.get('mediaUrl', '') == incomingData().sharedPost.mediaUrl
                  && get(/databases/$(database)/documents/posts/$(incomingData().sharedPost.id)).data.kind == incomingData().sharedPost.kind
                  && incomingData().sharedPost.text is string
                  && incomingData().sharedPost.text.size() <= 140
                  && get(/databases/$(database)/documents/posts/$(incomingData().sharedPost.id)).data.text[0:incomingData().sharedPost.text.size()] == incomingData().sharedPost.text))
          && (!('voice' in incomingData())
              || get(/databases/$(database)/documents/chats/$(chatId)/media/$(incomingData().voice.mediaId)).data.ownerId == request.auth.uid)
          && (!('photo' in incomingData())
              || (incomingData().photo.keys().hasOnly(['mediaId', 'width', 'height'])
                  && get(/databases/$(database)/documents/chats/$(chatId)/media/$(incomingData().photo.mediaId)).data.ownerId == request.auth.uid
                  && get(/databases/$(database)/documents/chats/$(chatId)/media/$(incomingData().photo.mediaId)).data.kind == 'image'))
          && (!('poll' in incomingData())
              || (incomingData().poll.votes == {}
                  && incomingData().poll.question is string && incomingData().poll.question.size() <= 200
                  && incomingData().poll.options is list && incomingData().poll.options.size() >= 2 && incomingData().poll.options.size() <= 6))
          && (!('call' in incomingData())
              || (incomingData().call.keys().hasOnly(['video', 'seconds', 'summary'])
                  && incomingData().call.video is bool
                  && incomingData().call.seconds is int && incomingData().call.seconds >= 0 && incomingData().call.seconds <= 86400
                  && incomingData().call.summary is string && incomingData().call.summary.size() <= 60))
          && (!('gif' in incomingData()) || gifOk(incomingData().gif))
          // Story replies must reference a real story by a chat member.
          && (!('storyReply' in incomingData()) || storyReplyOk(incomingData().storyReply))
          // No hate filter in DMs (block/report instead).
          && notSuspended()
          && !blockedInDm();
        allow update: if inChat() && (
          (resource.data.senderId == request.auth.uid
            && incomingData().diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && incomingData().text is string
            && incomingData().text.size() <= 2000
            && request.time < resource.data.createdAt + duration.value(15, 'm'))
          || (resource.data.senderId == request.auth.uid
            && incomingData().diff(resource.data).affectedKeys().hasOnly(['text', 'deleted', 'sharedPost', 'gif', 'voice', 'photo'])
            && incomingData().deleted == true)
          || (incomingData().diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && onlyMyKeyIn('reactions')
            && (!(request.auth.uid in incomingData().reactions)
                || (incomingData().reactions[request.auth.uid] is string
                    && incomingData().reactions[request.auth.uid].size() <= 16)))
          || (incomingData().diff(resource.data).affectedKeys().hasOnly(['poll'])
            && incomingData().poll.diff(resource.data.poll).affectedKeys().hasOnly(['votes'])
            && incomingData().poll.votes.diff(resource.data.poll.votes).affectedKeys()
                 .hasOnly([request.auth.uid])
            && (!(request.auth.uid in incomingData().poll.votes)
                || (incomingData().poll.votes[request.auth.uid] is int
                    && incomingData().poll.votes[request.auth.uid] >= 0
                    && incomingData().poll.votes[request.auth.uid] < resource.data.poll.options.size())))
        );
        allow delete: if signedIn() && (resource.data.senderId == request.auth.uid || isAdmin());
      }

      match /media/{mediaId} {
        allow read: if inChat();
        allow create: if inChat()
          && incomingData().ownerId == request.auth.uid
          && incomingData().data is string
          && incomingData().data.size() <= 900000
          && notSuspended()
          && ((incomingData().kind == 'audio'
                && incomingData().keys().hasOnly(['ownerId', 'kind', 'data', 'duration', 'createdAt'])
                && incomingData().data.matches('^data:audio/[a-z0-9.+-]+(;[a-z]+=[a-z0-9.,]+)*;base64,.*$')
                && incomingData().duration is number
                && incomingData().duration <= 61)
              || (incomingData().kind == 'image'
                && incomingData().keys().hasOnly(['ownerId', 'kind', 'data', 'width', 'height', 'createdAt'])
                && incomingData().data.matches('^data:image/(webp|jpeg|png);base64,.*$')
                && incomingData().width is int && incomingData().height is int));
        allow update: if false;
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }

      match /typing/{uid} {
        allow read: if inChat();
        allow create, update: if isUser(uid) && inChat()
          && incomingData().keys().hasOnly(['at']) && incomingData().at == request.time;
        allow delete: if isUser(uid);
      }
      // Read markers: now, or epoch for "mark unread".
      match /reads/{uid} {
        allow read: if inChat();
        allow create, update: if isUser(uid) && inChat()
          && incomingData().keys().hasOnly(['at'])
          && (incomingData().at == request.time || incomingData().at == timestamp.value(0));
        allow delete: if isUser(uid);
      }
    }

    // Presence and thoughts (server time only)
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isUser(uid)
        && incomingData().keys().hasOnly(['at']) && incomingData().at == request.time;
      allow delete: if isUser(uid);
    }
    match /thoughts/{uid} {
      allow read: if signedIn();
      allow create, update: if isUser(uid)
        && incomingData().keys().hasOnly(['text', 'username', 'createdAt'])
        && incomingData().text is string && incomingData().text.size() <= 60
        && isMyName(incomingData().username)
        && incomingData().createdAt == request.time
        && hateFree(incomingData().text)
        && notSuspended();
      allow delete: if isUser(uid);
    }

    // Spouse requests
    match /spouseRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && incomingData().keys().hasOnly(['fromUid', 'fromUsername', 'toUid', 'toUsername', 'status', 'createdAt'])
        && incomingData().fromUid == request.auth.uid
        && incomingData().toUid != request.auth.uid
        && isMyName(incomingData().fromUsername)
        && incomingData().toUsername == profileOf(incomingData().toUid).username
        && !blockedBy(incomingData().toUid)
        && incomingData().createdAt == request.time
        && incomingData().status == 'pending';
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && incomingData().diff(resource.data).affectedKeys().hasOnly(['status'])
        && incomingData().status in ['accepted', 'declined'];
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Circles
    match /groups/{groupId} {
      function isCircleOwner() {
        return signedIn() && resource.data.ownerId == request.auth.uid;
      }

      // Hidden circles: get by id only, never listed.
      allow get: if signedIn() || resource.data.privacy in ['public', 'private'];
      allow list: if resource.data.privacy in ['public', 'private'];

      function limitsOk(g) {
        return g.get('ageLimit', 0) in [0, 16, 18]
          // Cover ids are whitelisted: they're used as class names.
          && g.get('coverColor', 'from-violet-600 via-fuchsia-600 to-rose-500') in [
               'from-violet-600 via-fuchsia-600 to-rose-500', 'from-sky-600 via-cyan-500 to-emerald-500',
               'from-amber-500 via-orange-500 to-rose-500', 'from-emerald-600 via-teal-500 to-sky-500',
               'from-indigo-600 via-purple-600 to-pink-500']
          && g.get('rules', '') is string && g.get('rules', '').size() <= 2000
          && g.get('requireApproval', false) is bool
          && g.get('screeningQuestions', []) is list && g.get('screeningQuestions', []).size() <= 3
          && g.get('pinnedPostId', '') is string && g.get('pinnedPostId', '').size() <= 40
          && validTopics(g.get('interests', []))
          && g.get('automod', {}).get('postingPermission', 'members') in ['members', 'admins']
          && g.get('automod', {}).get('bannedWords', []).size() <= 40
          && g.get('automod', {}).get('newAccountDays', 0) in [0, 7, 30, 90, 180]
          && g.get('automod', {}).get('newAccountAction', 'decline') in ['decline', 'hold']
          && g.get('automod', {}).get('linkAction', 'allow') in ['allow', 'hold', 'block']
          && g.get('automod', {}).get('minLength', 0) in [0, 10, 20, 50]
          && g.get('automod', {}).get('slowModeMinutes', 0) in [0, 5, 15, 60]
          && g.get('featuredPostIds', []) is list && g.get('featuredPostIds', []).size() <= 3
          && g.get('topics', []) is list && g.get('topics', []).size() <= 12
          && g.get('topics', []).join(' ').size() <= 400
          && g.get('chatId', '') is string && g.get('chatId', '').size() <= 64;
      }

      // Banner and photo: the owner's own uploads, never external URLs.
      function circleImageOk(field) {
        return !incomingData().diff(resource.data).affectedKeys().hasAny([field])
          || incomingData()[field] == ''
          || incomingData()[field].matches('^https://firebasestorage[.]googleapis[.]com/.*')
          || ownInlineImage(incomingData()[field]);
      }

      allow create: if signedIn()
        && incomingData().keys().hasOnly([
          'name', 'description', 'privacy', 'ownerId', 'memberCount',
          'requireApproval', 'ageLimit', 'interests', 'rules', 'coverColor', 'pinnedPostId',
          'screeningQuestions', 'automod', 'createdAt', 'featuredPostIds', 'topics', 'chatId',
          'bannerUrl', 'photoUrl'
        ])
        && incomingData().get('bannerUrl', '') == ''
        && incomingData().get('photoUrl', '') == ''
        && incomingData().ownerId == request.auth.uid
        && incomingData().privacy in ['public', 'private', 'hidden']
        && limitsOk(incomingData())
        && oldEnoughFor(incomingData().get('ageLimit', 0))
        && incomingData().name is string
        && incomingData().name.size() >= 3
        && incomingData().name.size() <= 80
        && incomingData().description is string
        && incomingData().description.size() <= 1000
        && hateFree(incomingData().name + ' ' + incomingData().description + ' ' + incomingData().get('rules', '') + ' ' + incomingData().get('topics', []).join(' '))
        && notSuspended()
        && incomingData().createdAt == request.time
        && incomingData().get('pinnedPostId', '') == ''
        && incomingData().get('featuredPostIds', []) == []
        && incomingData().get('chatId', '') == ''
        && incomingData().memberCount == 1;
      allow update: if signedIn() && (
        (isCircleOwner()
          && incomingData().diff(resource.data).affectedKeys()
               .hasOnly(['name', 'description', 'privacy', 'requireApproval', 'ageLimit', 'interests',
                         'rules', 'coverColor', 'pinnedPostId',
                         'screeningQuestions', 'automod', 'featuredPostIds', 'topics', 'chatId',
                         'bannerUrl', 'photoUrl'])
          && incomingData().privacy in ['public', 'private', 'hidden']
          && circleImageOk('bannerUrl') && circleImageOk('photoUrl')
          && limitsOk(incomingData())
          && hateFree(incomingData().name + ' ' + incomingData().description + ' ' + incomingData().get('rules', '') + ' ' + incomingData().get('topics', []).join(' '))
          && (incomingData().get('chatId', '') == resource.data.get('chatId', '')
              || incomingData().chatId == ''
              || get(/databases/$(database)/documents/chats/$(incomingData().chatId)).data.get('circleId', '') == groupId))
        || (signedIn()
          && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'moderator']
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['pinnedPostId', 'featuredPostIds'])
          && limitsOk(incomingData()))
        || (incomingData().diff(resource.data).affectedKeys().hasOnly(['memberCount', 'lastMember'])
          && incomingData().lastMember is string
          && tiedCount(/databases/$(database)/documents/groups/$(groupId), 'memberCount',
                       /databases/$(database)/documents/groups/$(groupId)/members/$(incomingData().lastMember)))
      );
      allow delete: if isCircleOwner() || isAdmin();

      match /joinRequests/{uid} {
        allow read: if isUser(uid)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
          || (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'moderator']);
        allow create: if isUser(uid) && incomingData().agreedToRules == true
          && incomingData().keys().hasOnly(['uid', 'username', 'answers', 'agreedToRules', 'createdAt'])
          && incomingData().uid == uid
          && isMyName(incomingData().username)
          && incomingData().createdAt == request.time
          && incomingData().answers is list && incomingData().answers.size() <= 3
          && oldEnoughFor(get(/databases/$(database)/documents/groups/$(groupId)).data.get('ageLimit', 0));
        allow delete: if isUser(uid)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
          || (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
              && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'moderator']);
        allow update: if false;
      }

      match /members/{uid} {
        allow read: if signedIn();
        // Self-join only for open circles (public, no approval or screening, age ok).
        allow create: if incomingData().keys().hasOnly(['uid', 'username', 'role', 'joinedAt'])
          && incomingData().uid == uid
          && incomingData().username == profileOf(uid).username
          && incomingData().joinedAt == request.time
          && ((isUser(uid) && incomingData().role == 'member'
              && circleOf(groupId).privacy == 'public'
              && circleOf(groupId).get('requireApproval', false) != true
              && circleOf(groupId).get('screeningQuestions', []).size() == 0
              && oldEnoughFor(circleOf(groupId).get('ageLimit', 0)))
          || (isUser(uid) && incomingData().role == 'owner'
              && circleOf(groupId).ownerId == uid)
          || (signedIn() && incomingData().role == 'member'
              && isModOf(groupId)
              && exists(/databases/$(database)/documents/groups/$(groupId)/joinRequests/$(uid))));
        // Only the owner changes roles, never to owner.
        allow update: if signedIn() && (
          (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
            && incomingData().diff(resource.data).affectedKeys().hasOnly(['role'])
            && resource.data.role != 'owner'
            && incomingData().role in ['member', 'moderator'])
          || (exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role in ['owner', 'moderator']
            && incomingData().diff(resource.data).affectedKeys().hasOnly(['penalty', 'mutedUntil', 'strikes', 'lastStrikeAt'])
            && incomingData().get('strikes', 0) is int
            && (incomingData().get('lastStrikeAt', null) == resource.data.get('lastStrikeAt', null) || incomingData().lastStrikeAt == request.time)
            // The owner can penalise anyone else; moderators only members.
            && resource.data.role != 'owner'
            && (resource.data.role == 'member'
                || get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner')
            && (incomingData().get('mutedUntil', null) == null || incomingData().mutedUntil is timestamp))
          // Slow mode stamp.
          || (isUser(uid)
            && incomingData().diff(resource.data).affectedKeys().hasOnly(['lastPostAt'])
            && incomingData().lastPostAt == request.time)
        );
        // Leave, or removal by the owner (anyone else) or a mod (members only).
        allow delete: if isUser(uid)
          || (resource.data.role != 'owner'
              && (get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
                  || (resource.data.role == 'member'
                      && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))
                      && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'moderator')));
      }

      // Guides: readable with the circle; progress is per member and visible to admins.
      match /guides/{guideId} {
        allow read: if circleOf(groupId).privacy == 'public' || (signedIn() && isMemberOf(groupId));
        allow create, update: if isModOf(groupId)
          && incomingData().keys().hasOnly(['title', 'unitTitles', 'unitBodies', 'createdBy', 'createdAt', 'updatedAt'])
          && incomingData().title is string && incomingData().title.size() >= 2 && incomingData().title.size() <= 100
          && incomingData().unitTitles is list && incomingData().unitTitles.size() >= 1 && incomingData().unitTitles.size() <= 20
          && incomingData().unitBodies is list && incomingData().unitBodies.size() == incomingData().unitTitles.size()
          && incomingData().unitTitles.join(' ').size() <= 2000
          && incomingData().unitBodies.join(' ').size() <= 20000
          && hateFree(incomingData().title + ' ' + incomingData().unitTitles.join(' ') + ' ' + incomingData().unitBodies.join(' '))
          && incomingData().updatedAt == request.time
          && ((resource == null && incomingData().createdBy == request.auth.uid && incomingData().createdAt == request.time)
              || (resource != null && incomingData().createdBy == resource.data.createdBy && incomingData().createdAt == resource.data.createdAt));
        allow delete: if isModOf(groupId);
        match /progress/{uid} {
          allow read: if isUser(uid) || isModOf(groupId);
          allow create, update: if isUser(uid) && isMemberOf(groupId)
            && incomingData().keys().hasOnly(['done', 'updatedAt'])
            && incomingData().done is list && incomingData().done.size() <= 20
            && incomingData().updatedAt == request.time;
          allow delete: if isUser(uid) || isModOf(groupId);
        }
      }
    }

    // Gatherings. Private ones: host, invitees and circle members.
    function canViewEvent(e) {
      return e.privacy == 'public'
        || e.hostId == request.auth.uid
        || request.auth.uid in e.get('invitees', [])
        || (e.get('groupId', '') != '' && isMemberOf(e.groupId));
    }
    match /events/{eventId} {
      function isHost() {
        return signedIn() && resource.data.hostId == request.auth.uid;
      }
      function rsvpTie(status, field) {
        let rp = /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
        let was = exists(rp) && get(rp).data.status == status;
        let now = existsAfter(rp) && getAfter(rp).data.status == status;
        let before = resource.data.get(field, 0);
        let after = incomingData().get(field, 0);
        return after is int
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.get(field, 0) == after
          && ((after == before + 1 && now && !was)
              || (after == before - 1 && was && !now)
              || (after == before && was == now));
      }
      function eventLimitsOk(e) {
        return e.get('capacity', 0) is int
          && e.get('capacity', 0) >= 0
          && e.get('capacity', 0) <= 100000
          && e.get('guestPosting', 'guests') in ['guests', 'host']
          && e.get('invitees', []).size() <= 300;
      }

      // Public gatherings are readable signed out (invite links).
      allow get: if (signedIn() && canViewEvent(resource.data))
        || (resource.data.privacy == 'public'
            && (resource.data.get('groupId', '') == '' || circleOf(resource.data.groupId).privacy == 'public'));
      allow list: if (guest() && resource.data.privacy == 'public'
            && (resource.data.groupId == '' || circleOf(resource.data.groupId).privacy == 'public'))
        || (signedIn()
          && (resource.data.privacy == 'public'
              || resource.data.hostId == request.auth.uid
              || request.auth.uid in resource.data.invitees
              || (resource.data.groupId != '' && isMemberOf(resource.data.groupId))));

      allow create: if signedIn()
        && incomingData().keys().hasOnly([
          'title', 'description', 'location', 'startsAt', 'privacy', 'groupId',
          'ticketUrl', 'showGuestList', 'capacity', 'guestPosting', 'invitees',
          'hostId', 'hostName', 'goingCount', 'interestedCount', 'createdAt'
        ])
        && incomingData().hostId == request.auth.uid
        && isMyName(incomingData().hostName)
        && incomingData().createdAt == request.time
        && incomingData().get('showGuestList', true) is bool
        && incomingData().privacy in ['public', 'private']
        && incomingData().title is string
        && incomingData().title.size() >= 3
        && incomingData().title.size() <= 150
        && incomingData().description is string
        && incomingData().description.size() <= 2000
        && incomingData().location is string
        && incomingData().location.size() <= 300
        && hateFree(incomingData().title + ' ' + incomingData().description + ' ' + incomingData().location)
        && notSuspended()
        && incomingData().startsAt is timestamp
        && incomingData().startsAt > request.time - duration.value(1, 'd')
        && incomingData().startsAt < request.time + duration.value(1100, 'd')
        && incomingData().goingCount == 1
        && incomingData().interestedCount == 0
        && eventLimitsOk(incomingData())
        && (incomingData().ticketUrl == '' || incomingData().ticketUrl.matches('^https?://.*'))
        // Circle gatherings: members only; admins only if the circle restricts posting.
        && (incomingData().groupId == ''
            || (isMemberOf(incomingData().groupId)
                && (circleOf(incomingData().groupId).get('automod', {}).get('postingPermission', 'members') != 'admins'
                    || isModOf(incomingData().groupId))));
      allow update: if signedIn() && (
        (isHost()
          && incomingData().diff(resource.data).affectedKeys()
               .hasOnly(['title', 'description', 'location', 'startsAt', 'ticketUrl', 'showGuestList',
                         'privacy', 'capacity', 'guestPosting', 'invitees'])
          && incomingData().privacy in ['public', 'private']
          && eventLimitsOk(incomingData()))
        // Head counts move by at most one, only with the caller's own RSVP; going can't exceed capacity.
        || (canViewEvent(resource.data)
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['goingCount', 'interestedCount'])
          && rsvpTie('going', 'goingCount')
          && rsvpTie('interested', 'interestedCount')
          && (resource.data.get('capacity', 0) == 0
              || incomingData().get('goingCount', 0) <= resource.data.capacity
              || incomingData().get('goingCount', 0) < resource.data.get('goingCount', 0)))
      );
      allow delete: if isHost();

      // Going only with the head-count increment; the host's RSVP is written with the event.
      match /rsvps/{uid} {
        function ev() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }
        function evAfter() {
          return getAfter(/databases/$(database)/documents/events/$(eventId)).data;
        }
        // Hidden guest lists: guests see only their own RSVP.
        allow read: if signedIn()
          && (isUser(uid)
              || ev().hostId == request.auth.uid
              || (ev().get('showGuestList', true) == true && canViewEvent(ev())));
        allow create, update: if isUser(uid)
          && canViewEvent(ev())
          && incomingData().keys().hasOnly(['status', 'username', 'createdAt'])
          && isMyName(incomingData().username)
          && incomingData().status in ['going', 'interested', 'maybe', 'cant']
          && (incomingData().status != 'going'
              || ev().hostId == request.auth.uid
              || (resource != null && resource.data.status == 'going')
              || (evAfter().get('goingCount', 0) == ev().get('goingCount', 0) + 1
                  && (evAfter().get('capacity', 0) == 0
                      || evAfter().get('goingCount', 0) <= evAfter().get('capacity', 0))));
        allow delete: if isUser(uid)
          && (resource.data.status != 'going'
              || ev().hostId == request.auth.uid
              || evAfter().get('goingCount', 0) == ev().get('goingCount', 0) - 1);
      }

      // Discussion inherits event visibility; host always posts, guests unless host-only.
      match /posts/{postId} {
        function ev() {
          return get(/databases/$(database)/documents/events/$(eventId)).data;
        }
        allow read: if signedIn() && canViewEvent(ev());
        allow create: if signedIn()
          && incomingData().keys().hasOnly([
            'authorId', 'authorName', 'authorDisplayName', 'authorPhoto', 'text', 'likedBy', 'createdAt'
          ])
          && authorIsMe(incomingData())
          && incomingData().text is string
          && incomingData().text.size() >= 1
          && incomingData().text.size() <= 1000
          && hateFree(incomingData().text)
          && notSuspended()
          && incomingData().likedBy == []
          && incomingData().createdAt == request.time
          && canViewEvent(ev())
          && (ev().hostId == request.auth.uid
              || (ev().get('guestPosting', 'guests') == 'guests'
                  && exists(/databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid))));
        allow update: if signedIn()
          && canViewEvent(ev())
          && incomingData().diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && incomingData().likedBy.toSet().difference(resource.data.likedBy.toSet())
               .union(resource.data.likedBy.toSet().difference(incomingData().likedBy.toSet()))
               == [request.auth.uid].toSet();
        allow delete: if signedIn()
          && (resource.data.authorId == request.auth.uid || ev().hostId == request.auth.uid);
      }

      // Legacy announcements (read-only).
      match /announcements/{announcementId} {
        allow read: if signedIn()
          && canViewEvent(get(/databases/$(database)/documents/events/$(eventId)).data);
        allow create, update: if false;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
