{
  "appId": "com.meshsocial.app",
  "appName": "Mesh",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#09090b",
    "scheme": "Mesh"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#09090b",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#09090b",
      "style": "DARK"
    }
  }
}
